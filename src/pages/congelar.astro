---
/**
 * Congelar y descongelar.
 *
 * Es lo que decide si un plan de siete días se sostiene: cocinar de más y
 * congelar bien es lo que salva el miércoles a las nueve de la noche, cuando la
 * alternativa real no es otra receta sino pedir delivery.
 */
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import { PRINCIPIOS_FREEZER, COMO_CONGELAR, NO_SE_CONGELA } from "../data/cocina.js";

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      name: "Cómo congelar y descongelar comida keto",
      inLanguage: "es-AR",
      description:
        "Qué se congela y qué no, cuánto dura cada cosa y cómo descongelarla sin arruinarla.",
      step: COMO_CONGELAR.map((c, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: c.que,
        text: `${c.como} Se conserva ${c.tiempo}. Para descongelar: ${c.descongelar}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
        { "@type": "ListItem", position: 2, name: "Congelar y descongelar" },
      ],
    },
  ],
};
---

<Layout
  titulo="Congelar y descongelar"
  descripcion="Qué se congela y qué no en una dieta keto, cuánto dura cada cosa en el freezer y cómo descongelarla sin que suelte todo el líquido."
  jsonld={jsonld}
>
  <nav class="text-sm text-hoja-900/50 mb-4" aria-label="Miga de pan">
    <a href="/" class="hover:underline">Inicio</a>
  </nav>

  <article class="prosa">
    <h1 class="text-3xl md:text-4xl font-bold text-hoja-700 leading-tight">
      Congelar y descongelar
    </h1>
    <p class="mt-4 text-lg text-hoja-900/80 leading-relaxed border-l-4 border-hoja-500 pl-4">
      El plan de siete días se cae casi siempre el mismo día: el miércoles a la noche,
      cuando hay que cocinar de cero y la alternativa es pedir. El freezer bien usado es lo
      que resuelve ese miércoles, y usarlo bien son cuatro reglas y una tabla.
    </p>

    <h2 class="mt-10 text-2xl font-bold text-hoja-700">Las cuatro reglas</h2>
    <div class="mt-4 grid sm:grid-cols-2 gap-4">
      {PRINCIPIOS_FREEZER.map((p) => (
        <section class="rounded-xl border border-hoja-100 bg-white p-5">
          <h3 class="font-semibold text-hoja-700 leading-snug">{p.titulo}</h3>
          <p class="mt-2 text-sm text-hoja-900/75 leading-relaxed">{p.texto}</p>
        </section>
      ))}
    </div>

    <AdSlot formato="horizontal" />

    <h2 class="mt-8 text-2xl font-bold text-hoja-700">Cosa por cosa</h2>
    <div class="mt-4 space-y-3">
      {COMO_CONGELAR.map((c) => (
        <section class="rounded-xl border border-hoja-100 bg-white p-5">
          <div class="flex items-baseline justify-between gap-3 flex-wrap">
            <h3 class="font-semibold text-hoja-700">{c.que}</h3>
            <span class="text-xs px-2.5 py-1 rounded-full bg-hoja-100 text-hoja-700 whitespace-nowrap">
              {c.tiempo}
            </span>
          </div>
          <dl class="mt-3 space-y-2 text-sm">
            <div>
              <dt class="font-medium text-hoja-900/55">Cómo</dt>
              <dd class="text-hoja-900/80 leading-relaxed">{c.como}</dd>
            </div>
            <div>
              <dt class="font-medium text-hoja-900/55">Descongelar</dt>
              <dd class="text-hoja-900/80 leading-relaxed">{c.descongelar}</dd>
            </div>
          </dl>
          <p class="mt-3 text-sm text-naranja-700 bg-naranja-400/10 border-l-4 border-naranja-500 rounded-r-lg px-3 py-2 leading-relaxed">
            {c.ojo}
          </p>
        </section>
      ))}
    </div>

    <h2 class="mt-10 text-2xl font-bold text-hoja-700">Lo que no se congela</h2>
    <p class="mt-2 text-hoja-900/70 leading-relaxed">
      No porque sea peligroso, sino porque vuelve mal y termina en la basura igual.
    </p>
    <ul class="mt-4 grid sm:grid-cols-2 gap-2">
      {NO_SE_CONGELA.map(([que, porque]) => (
        <li class="flex items-start gap-2 rounded-lg border border-red-200 bg-white px-4 py-2.5">
          <span class="text-red-500 shrink-0" aria-hidden="true">🚫</span>
          <span class="text-sm">
            <strong class="text-hoja-900/85 font-medium">{que}</strong>
            <span class="text-hoja-900/55"> — {porque}</span>
          </span>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-sm text-hoja-900/60 leading-relaxed">
      Cada ingrediente tiene además su propia ficha con cómo guardarlo:{" "}
      <a href="/productos" class="text-naranja-600 hover:underline">todo lo que se compra</a>.
      Y los trucos de cocción están en{" "}
      <a href="/trucos" class="text-naranja-600 hover:underline">trucos de cocina</a>.
    </p>
  </article>

  <AdSlot formato="rectangulo" />
</Layout>
