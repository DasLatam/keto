---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import ListaCompras from "../components/ListaCompras.astro";
import SelectorAyuno from "../components/SelectorAyuno.astro";
import SelectorSemana from "../components/SelectorSemana.astro";
import { SEMANAS, RECETAS } from "../data/recetas.js";
import { textoItem } from "../lib/porciones.js";
import { listaDe } from "../lib/compras.js";

const porSlug = Object.fromEntries(RECETAS.map((r) => [r.slug, r]));
const CLAVES = ["desayuno", "almuerzo", "merienda", "cena"];

// Una compra por semana. Las listas se derivan de las recetas —ver
// `lib/compras.js`— así que cambiar el plan cambia la lista y no hay forma de
// que queden diciendo cosas distintas.
const semanas = SEMANAS.map((sem) => {
  const recetas = sem.dias.flatMap((d) =>
    CLAVES.map((c) => ({ receta: porSlug[d[c]], comida: c })).filter((x) => x.receta));
  const { sectores } = listaDe(recetas);
  const platos = recetas.map((x) => x.receta);
  return {
    ...sem,
    sectores,
    // El total de porciones no es 28: hay recetas que rinden 4 u 8 —una tarta,
    // un cheesecake— y esas dejan sobras que cubren otra comida.
    totalItems: sectores.reduce((n, x) => n + x.items.length, 0),
    totalPorciones: platos.reduce((n, r) => n + r.porciones, 0),
    caloriasDia: Math.round(platos.reduce((n, r) => n + r.macros.calorias, 0) / 7),
  };
});

const jsonld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Lista de compras keto semanal",
  numberOfItems: semanas[0].totalItems,
  itemListElement: semanas[0].sectores.flatMap((s, si) =>
    s.items.map((item, ii) => ({
      "@type": "ListItem",
      position: si * 100 + ii + 1,
      // La lista estructurada declara las cantidades de la primera semana para
      // una persona, que es la base: el escalado por grupo familiar y el cambio
      // de semana ocurren en el navegador y no tienen sentido acá.
      name: textoItem(item, 1),
    }))
  ),
};
---

<Layout
  titulo="Lista de compras keto semanal, para una persona o para toda la familia"
  descripcion="La lista completa del supermercado para una semana entera de dieta keto, agrupada por sector y con las cantidades calculadas para la cantidad de personas que sean en tu casa."
  jsonld={jsonld}
>
  <h1 class="text-3xl md:text-4xl font-bold text-hoja-700">Las cuatro compras del mes</h1>
  <p class="mt-3 text-hoja-900/70 max-w-2xl leading-relaxed">
    Una lista por cada semana del <a href="/plan-semanal" class="text-naranja-600 hover:underline">plan
    del mes</a>: todo lo que hace falta para las <strong>28 comidas</strong> de esa semana
    —siete desayunos, siete almuerzos, siete meriendas y siete cenas, sin repetir ninguna
    receta—, agrupado como se recorre el súper para no ir y volver entre góndolas.
  </p>
  <p class="mt-3 text-hoja-900/70 max-w-2xl leading-relaxed">
    Cada lista sale de los ingredientes de las recetas de su semana, sumados y convertidos
    a cantidades de góndola. No está escrita a mano: si una receta cambia, la lista cambia.
  </p>

  <div class="mt-6">
    <SelectorSemana etiqueta="Qué compra estás haciendo" />
  </div>
  <p class="mt-3 text-hoja-900/70 max-w-2xl leading-relaxed">
    Las cantidades están escritas <strong>para una persona</strong>. Decile cuántos son en
    tu casa y se recalculan solas, con los redondeos que tienen sentido en la góndola: no
    vas a ver «2400 g de pechuga» sino «2,4 kg», ni fracciones de atado de acelga.
  </p>

  {semanas.map((sem, si) => (
  <div class:list={["mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3", si > 0 && "hidden"]} data-semana={si + 1}>
    {[
      ["Comidas", 28],
      ["Porciones que rinde", sem.totalPorciones],
      ["Calorías por día", sem.caloriasDia],
      ["Ítems en la lista", sem.totalItems],
    ].map(([k, v]) => (
      <div class="rounded-xl bg-white border border-hoja-100 p-4 text-center">
        <div class="text-2xl font-bold text-hoja-700">{v}</div>
        <div class="text-[11px] uppercase tracking-wide text-hoja-900/50 mt-1 leading-tight">{k}</div>
      </div>
    ))}
  </div>
  ))}
  <p class="mt-2 text-sm text-hoja-900/50 max-w-2xl leading-relaxed">
    Las porciones son más que las comidas porque varias recetas rinden de más —una tarta
    rinde 4, un cheesecake 8—: esas sobras son las que cubren la comida del día siguiente.
    Las calorías por día son la suma de las cuatro comidas del plan, una porción de cada
    una.
  </p>

  <div class="mt-8">
    <div class="mb-6 no-print">
      <SelectorAyuno nota="Las cantidades bajan en proporción a las comidas que dejás de hacer, y lo que sólo servía para esas comidas sale de la lista. La despensa —aceite, condimentos, edulcorante— no se toca: rinde varias semanas igual." />
    </div>

    {semanas.map((sem, si) => (
      <div class:list={[si > 0 && "hidden"]} data-semana={si + 1}>
        <ListaCompras semana={si + 1} />
      </div>
    ))}
  </div>

  <AdSlot formato="horizontal" />

  <section class="mt-4 no-print">
    <h2 class="text-2xl font-bold text-hoja-700">Qué se cocina con todo esto</h2>
    <p class="mt-1 text-sm text-hoja-900/60">
      Las 28 recetas que cubre esta compra, con lo que rinde cada una y sus calorías por
      porción. Si vas a saltear alguna comida, mirá acá qué podés no llevar.
      <span data-aviso-veces class="hidden"></span>
    </p>

    {semanas.map((sem, si) => (
    <div class:list={["mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3", si > 0 && "hidden"]} data-semana={si + 1}>
      {sem.dias.map((d) => {
        const delDia = CLAVES.map((c) => porSlug[d[c]]).filter(Boolean);
        const kcal = delDia.reduce((n, r) => n + r.macros.calorias, 0);
        const carbos = delDia.reduce((n, r) => n + r.macros.carbos, 0);
        return (
          <div class="rounded-xl border border-hoja-100 bg-white p-4">
            <h3 class="font-semibold text-hoja-700 text-sm flex items-baseline justify-between gap-2">
              {d.dia}
              <span class="text-xs font-normal text-hoja-900/45">{kcal} cal · {carbos} g</span>
            </h3>
            <ul class="mt-2 space-y-1">
              {delDia.map((r) => (
                <li class="text-sm flex items-baseline justify-between gap-2">
                  <a href={`/recetas/${r.slug}`} class="text-hoja-900/70 hover:text-naranja-600">
                    {r.nombre}
                  </a>
                  <span
                    data-rinde={r.porciones}
                    class="text-xs text-hoja-900/40 whitespace-nowrap shrink-0"
                  >
                    {r.macros.calorias} cal · rinde {r.porciones}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
    ))}
  </section>

  <aside class="mt-8 rounded-xl bg-crema-100 border border-hoja-100 p-5 max-w-3xl no-print">
    <p class="text-sm text-hoja-900/70 leading-relaxed">
      <strong class="text-hoja-700">Cuando son más de uno.</strong> Las recetas rinden
      distinto: la que rinde 1 porción hay que hacerla tantas veces como personas sean, y
      la que rinde 4 alcanza para cuatro de una sola vez. Cada receta dice lo que rinde en
      su tarjeta y en su página. Si en tu casa hay chicos, van a comer menos que un adulto:
      el multiplicador de esta lista los cuenta como uno, así que probablemente te sobre
      algo — que es mejor que faltar.
    </p>
    <p class="mt-3 text-sm text-hoja-900/70 leading-relaxed">
      <a href="/calendario" class="text-naranja-600 hover:underline font-medium">Agendá la compra semanal →</a>
      {" "}Casi todos los planes se caen el miércoles, y casi siempre es porque el domingo
      nadie fue al súper.
    </p>
  </aside>

<script>
  import { vecesQueRinde } from "../lib/porciones.js";

  /**
   * Cuántas veces hay que hacer cada receta para los que son en la casa.
   *
   * Sin esto, con tres personas la lista del súper triplicaba las cantidades y
   * esta sección seguía diciendo "rinde 1": dos números de la misma página que
   * se contradicen, y el que queda mal es el de la lista, que es el que se usa
   * para comprar.
   */
  const celdas = document.querySelectorAll("[data-rinde]");
  const aviso = document.querySelector("[data-aviso-veces]");

  function pintar(personas) {
    for (const el of celdas) {
      const rinde = Number(el.dataset.rinde);
      const veces = vecesQueRinde(rinde, personas);
      const cal = el.textContent.trim().split(" cal")[0];
      el.textContent =
        veces > 1
          ? `${cal} cal · rinde ${rinde} · hacela ${veces} veces`
          : `${cal} cal · rinde ${rinde}`;
      el.classList.toggle("text-naranja-600", veces > 1);
      el.classList.toggle("text-hoja-900/40", veces <= 1);
    }
    if (aviso) {
      aviso.classList.toggle("hidden", personas <= 1);
      aviso.textContent = personas <= 1 ? "" :
        ` Son ${personas} en tu casa: las que rinden menos que eso hay que hacerlas ` +
        `más de una vez, y por eso la lista pide más cantidad.`;
    }
  }

  document.addEventListener("keto:personas", (e) => pintar(e.detail.personas));
</script>
</Layout>

<style>
  @media print {
    /* Los botones (destildar, imprimir, el selector de personas) no tienen
       sentido en papel, y el selector menos que ninguno: en la hoja impresa las
       cantidades ya salieron calculadas. */
    .no-print, header, footer, aside, button { display: none !important; }
    .grid { display: block; }
    section { break-inside: avoid; margin-bottom: 1rem; }
  }
</style>
