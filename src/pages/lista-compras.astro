---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import ListaCompras from "../components/ListaCompras.astro";
import { LISTA_COMPRAS, PLAN_SEMANAL, RECETAS } from "../data/recetas.js";
import { textoItem } from "../lib/porciones.js";

const porSlug = Object.fromEntries(RECETAS.map((r) => [r.slug, r]));
const CLAVES = ["desayuno", "almuerzo", "merienda", "cena"];

const totalItems = LISTA_COMPRAS.reduce((n, s) => n + s.items.length, 0);

// Las 28 comidas del plan, con sus porciones y calorías. El total de porciones no
// es 28: hay recetas que rinden 4 u 8 —una tarta, un cheesecake— y esas dejan
// sobras que cubren otra comida.
const recetasSemana = PLAN_SEMANAL.flatMap((d) =>
  CLAVES.map((c) => porSlug[d[c]]).filter(Boolean)
);
const totalPorciones = recetasSemana.reduce((n, r) => n + r.porciones, 0);
const caloriasSemana = recetasSemana.reduce((n, r) => n + r.macros.calorias, 0);
const caloriasDia = Math.round(caloriasSemana / 7);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Lista de compras keto semanal",
  numberOfItems: totalItems,
  itemListElement: LISTA_COMPRAS.flatMap((s, si) =>
    s.items.map((item, ii) => ({
      "@type": "ListItem",
      position: si * 100 + ii + 1,
      // La lista estructurada declara las cantidades para una persona, que es la
      // base: el escalado por grupo familiar ocurre en el navegador y no tiene
      // sentido en los datos estructurados.
      name: textoItem(item, 1),
    }))
  ),
};
---

<Layout
  titulo="Lista de compras keto semanal, para una persona o para toda la familia"
  descripcion="La lista completa del supermercado para una semana entera de dieta keto, agrupada por sector y con las cantidades calculadas para la cantidad de personas que sean en tu casa."
  jsonld={jsonld}
>
  <h1 class="text-3xl md:text-4xl font-bold text-hoja-700">Lista del súper, una semana</h1>
  <p class="mt-3 text-hoja-900/70 max-w-2xl leading-relaxed">
    Todo lo que hace falta para las <strong>28 comidas</strong> del plan semanal: siete
    desayunos, siete almuerzos, siete meriendas y siete cenas, sin repetir ninguna
    receta. Está agrupada como se recorre el súper para no ir y volver entre góndolas.
  </p>
  <p class="mt-3 text-hoja-900/70 max-w-2xl leading-relaxed">
    Las cantidades están escritas <strong>para una persona</strong>. Decile cuántos son en
    tu casa y se recalculan solas, con los redondeos que tienen sentido en la góndola: no
    vas a ver «2400 g de pechuga» sino «2,4 kg», ni fracciones de atado de acelga.
  </p>

  <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
    {[
      ["Comidas", 28],
      ["Porciones que rinde", totalPorciones],
      ["Calorías por día", caloriasDia],
      ["Ítems en la lista", totalItems],
    ].map(([k, v]) => (
      <div class="rounded-xl bg-white border border-hoja-100 p-4 text-center">
        <div class="text-2xl font-bold text-hoja-700">{v}</div>
        <div class="text-[11px] uppercase tracking-wide text-hoja-900/50 mt-1 leading-tight">{k}</div>
      </div>
    ))}
  </div>
  <p class="mt-2 text-sm text-hoja-900/50 max-w-2xl leading-relaxed">
    Las porciones son más que las comidas porque varias recetas rinden de más —una tarta
    rinde 4, un cheesecake 8—: esas sobras son las que cubren la comida del día siguiente.
    Las calorías por día son la suma de las cuatro comidas del plan, una porción de cada
    una.
  </p>

  <div class="mt-8">
    <ListaCompras />
  </div>

  <AdSlot formato="horizontal" />

  <section class="mt-4 no-print">
    <h2 class="text-2xl font-bold text-hoja-700">Qué se cocina con todo esto</h2>
    <p class="mt-1 text-sm text-hoja-900/60">
      Las 28 recetas que cubre esta compra, con lo que rinde cada una y sus calorías por
      porción. Si vas a saltear alguna comida, mirá acá qué podés no llevar.
    </p>

    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {PLAN_SEMANAL.map((d) => {
        const delDia = CLAVES.map((c) => porSlug[d[c]]).filter(Boolean);
        const kcal = delDia.reduce((n, r) => n + r.macros.calorias, 0);
        const carbos = delDia.reduce((n, r) => n + r.macros.carbos, 0);
        return (
          <div class="rounded-xl border border-hoja-100 bg-white p-4">
            <h3 class="font-semibold text-hoja-700 text-sm flex items-baseline justify-between gap-2">
              {d.dia}
              <span class="text-xs font-normal text-hoja-900/45">{kcal} cal · {carbos} g</span>
            </h3>
            <ul class="mt-2 space-y-1">
              {delDia.map((r) => (
                <li class="text-sm flex items-baseline justify-between gap-2">
                  <a href={`/recetas/${r.slug}`} class="text-hoja-900/70 hover:text-naranja-600">
                    {r.nombre}
                  </a>
                  <span class="text-xs text-hoja-900/40 whitespace-nowrap shrink-0">
                    {r.macros.calorias} cal · rinde {r.porciones}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <aside class="mt-8 rounded-xl bg-crema-100 border border-hoja-100 p-5 max-w-3xl no-print">
    <p class="text-sm text-hoja-900/70 leading-relaxed">
      <strong class="text-hoja-700">Cuando son más de uno.</strong> Las recetas rinden
      distinto: la que rinde 1 porción hay que hacerla tantas veces como personas sean, y
      la que rinde 4 alcanza para cuatro de una sola vez. Cada receta dice lo que rinde en
      su tarjeta y en su página. Si en tu casa hay chicos, van a comer menos que un adulto:
      el multiplicador de esta lista los cuenta como uno, así que probablemente te sobre
      algo — que es mejor que faltar.
    </p>
    <p class="mt-3 text-sm text-hoja-900/70 leading-relaxed">
      <a href="/calendario" class="text-naranja-600 hover:underline font-medium">Agendá la compra semanal →</a>
      {" "}Casi todos los planes se caen el miércoles, y casi siempre es porque el domingo
      nadie fue al súper.
    </p>
  </aside>
</Layout>

<style>
  @media print {
    /* Los botones (destildar, imprimir, el selector de personas) no tienen
       sentido en papel, y el selector menos que ninguno: en la hoja impresa las
       cantidades ya salieron calculadas. */
    .no-print, header, footer, aside, button { display: none !important; }
    .grid { display: block; }
    section { break-inside: avoid; margin-bottom: 1rem; }
  }
</style>
