---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { NEGOCIACIONES, CATEGORIAS_NEG } from "../../data/negociemos.js";
---

<Layout
  titulo="Qué sí, qué no, negociemos"
  descripcion="Comparativas honestas para dieta keto: cerveza vino o whisky, lentejas porotos o garbanzos, salvado chipá o galletas de arroz. Con los carbohidratos de cada opción."
>
  <h1 class="text-3xl md:text-4xl font-bold text-hoja-700">Qué sí, qué no, negociemos</h1>
  <p class="mt-3 text-hoja-900/70 max-w-2xl leading-relaxed">
    La mayoría de las guías keto contestan «no» y se acaba la charla. Pero igual vas
    a ir a un cumpleaños, y ahí la pregunta útil no es si se puede: es{" "}
    <strong>cuál de las opciones hace menos daño y por qué</strong>. Eso es lo que
    hay acá, con el número adelante.
  </p>

  <AdSlot formato="horizontal" />

  {CATEGORIAS_NEG.map((cat) => {
    const items = NEGOCIACIONES.filter((n) => n.categoria === cat.id);
    if (items.length === 0) return null;
    return (
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-hoja-900/40">
          {cat.nombre}
        </h2>
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          {items.map((n) => (
            <a
              href={`/negociemos/${n.slug}`}
              class="group rounded-xl border border-hoja-100 bg-white p-5 hover:border-hoja-500 hover:shadow-lg transition-all"
            >
              <h3 class="font-semibold text-lg text-hoja-700 group-hover:text-naranja-600 leading-snug">
                {n.titulo}
              </h3>
              <p class="mt-2 text-sm text-hoja-900/70 leading-relaxed">{n.resumen}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {n.opciones.slice(0, 4).map((o) => (
                  <li
                    class:list={[
                      "text-[11px] px-2 py-0.5 rounded-full",
                      o.estado === "si" ? "bg-hoja-100 text-hoja-700"
                      : o.estado === "negociable" ? "bg-naranja-400/20 text-naranja-600"
                      : "bg-red-100 text-red-700",
                    ]}
                  >
                    {o.nombre.split("(")[0].split(",")[0].trim()}
                  </li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <AdSlot formato="rectangulo" />
</Layout>
