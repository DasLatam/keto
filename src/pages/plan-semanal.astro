---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import { PLAN_SEMANAL, LISTA_COMPRAS, RECETAS } from "../data/recetas.js";

const porSlug = Object.fromEntries(RECETAS.map((r) => [r.slug, r]));
const COMIDAS_DIA = [
  ["desayuno", "Desayuno"],
  ["almuerzo", "Almuerzo"],
  ["merienda", "Merienda"],
  ["cena", "Cena"],
];
---

<Layout
  titulo="Plan keto semanal con lista de compras"
  descripcion="Siete días de dieta keto armados, con recetas argentinas y la lista de compras agrupada por sector del supermercado, con checkboxes para marcar."
>
  <h1 class="text-3xl font-bold text-hoja-700">Plan de la semana</h1>
  <p class="mt-2 text-hoja-900/70 max-w-2xl">
    Siete días resueltos. Las recetas se repiten a propósito: cocinar de más una vez
    y comerlo dos veces es lo que hace que un plan se sostenga más allá del jueves.
  </p>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full min-w-[640px] border-separate border-spacing-1">
      <thead>
        <tr>
          <th class="text-left text-sm font-semibold text-hoja-900/50 px-2 py-1">Día</th>
          {COMIDAS_DIA.map(([, nombre]) => (
            <th class="text-left text-sm font-semibold text-hoja-900/50 px-2 py-1">{nombre}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {PLAN_SEMANAL.map((d) => (
          <tr>
            <th scope="row" class="text-left align-top bg-hoja-600 text-crema-50 rounded-lg px-3 py-3 text-sm font-semibold whitespace-nowrap">
              {d.dia}
            </th>
            {COMIDAS_DIA.map(([clave]) => {
              const r = porSlug[d[clave]];
              return (
                <td class="align-top bg-white border border-hoja-100 rounded-lg p-3">
                  {r ? (
                    <a href={`/recetas/${r.slug}`} class="block group">
                      <span class="text-sm font-medium text-hoja-700 group-hover:text-naranja-600 leading-snug">
                        {r.nombre}
                      </span>
                      <span class="block mt-1 text-xs text-hoja-900/50">
                        {r.macros.carbos} g carbos · {r.minutos} min
                      </span>
                    </a>
                  ) : (
                    <span class="text-sm text-hoja-900/30">—</span>
                  )}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <AdSlot formato="horizontal" />

  <section class="mt-4">
    <div class="flex items-baseline justify-between flex-wrap gap-2">
      <h2 class="text-2xl font-bold text-hoja-700">Lista de compras</h2>
      <button id="limpiar" class="text-sm text-naranja-600 hover:underline">
        Destildar todo
      </button>
    </div>
    <p class="mt-1 text-sm text-hoja-900/60">
      Agrupada como se recorre el súper. Lo que tildes queda guardado en este
      teléfono, así que podés ir marcando mientras comprás.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {LISTA_COMPRAS.map((s) => (
        <section class="rounded-xl border border-hoja-100 bg-white p-5">
          <h3 class="font-semibold text-hoja-700 mb-3">{s.sector}</h3>
          <ul class="space-y-2.5">
            {s.items.map((item) => (
              <li>
                <label class="flex items-start gap-3 cursor-pointer group">
                  <input
                    type="checkbox" class="compra mt-0.5 w-5 h-5 rounded accent-hoja-600 shrink-0"
                    data-item={`${s.sector}::${item}`}
                  />
                  <span class="text-hoja-900/80 group-has-checked:line-through group-has-checked:text-hoja-900/35 transition-colors">
                    {item}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Layout>

<script>
  // Los tildes se guardan en localStorage: la lista se usa caminando por el súper
  // y cualquier recarga o cambio de pestaña borraría el progreso.
  const CLAVE = "keto-lista-compras";
  const cajas = [...document.querySelectorAll(".compra")];

  let guardado = {};
  try {
    guardado = JSON.parse(localStorage.getItem(CLAVE) ?? "{}");
  } catch {
    guardado = {};
  }

  function persistir() {
    const estado = {};
    for (const c of cajas) if (c.checked) estado[c.dataset.item] = true;
    localStorage.setItem(CLAVE, JSON.stringify(estado));
  }

  for (const c of cajas) {
    c.checked = Boolean(guardado[c.dataset.item]);
    c.addEventListener("change", persistir);
  }

  document.getElementById("limpiar").addEventListener("click", () => {
    for (const c of cajas) c.checked = false;
    persistir();
  });
</script>
