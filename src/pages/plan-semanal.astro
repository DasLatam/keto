---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import ListaCompras from "../components/ListaCompras.astro";
import SelectorAyuno from "../components/SelectorAyuno.astro";
import SelectorSemana from "../components/SelectorSemana.astro";
import { SEMANAS, RECETAS } from "../data/recetas.js";

const porSlug = Object.fromEntries(RECETAS.map((r) => [r.slug, r]));
const COMIDAS_DIA = [
  ["desayuno", "Desayuno"],
  ["almuerzo", "Almuerzo"],
  ["merienda", "Merienda"],
  ["cena", "Cena"],
];

// Totales de cada día: es el dato que hacía falta para que el plan se pueda usar
// junto con la calculadora de macros. Sin el total diario, saber que un desayuno
// tiene 430 calorías no le dice a nadie si el día cierra.
function conTotales(dias) {
  return dias.map((d) => {
    const comidas = COMIDAS_DIA.map(([clave]) => porSlug[d[clave]]);
    const presentes = comidas.filter(Boolean);
    return {
      ...d,
      comidas,
      calorias: presentes.reduce((n, r) => n + r.macros.calorias, 0),
      carbos: presentes.reduce((n, r) => n + r.macros.carbos, 0),
      grasas: presentes.reduce((n, r) => n + r.macros.grasas, 0),
      proteinas: presentes.reduce((n, r) => n + r.macros.proteinas, 0),
    };
  });
}

const promedioDe = (dias) => ({
  calorias: Math.round(dias.reduce((n, d) => n + d.calorias, 0) / dias.length),
  carbos: Math.round(dias.reduce((n, d) => n + d.carbos, 0) / dias.length),
  grasas: Math.round(dias.reduce((n, d) => n + d.grasas, 0) / dias.length),
  proteinas: Math.round(dias.reduce((n, d) => n + d.proteinas, 0) / dias.length),
});

// Las cuatro semanas salen renderizadas del build y el selector muestra una.
// Son 112 filas de HTML estático: pesan menos que el JavaScript que haría falta
// para armarlas en el navegador, y funcionan con el buscador y con Ctrl+F.
const semanas = SEMANAS.map((s) => {
  const dias = conTotales(s.dias);
  return { ...s, dias, promedio: promedioDe(dias) };
});

const dias = semanas[0].dias;
const promedio = semanas[0].promedio;
const todos = semanas.flatMap((s) => s.dias);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "¿Cuántas calorías tiene un día del plan keto?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `El plan tiene cuatro semanas y las cuatro promedian alrededor de ${promedio.calorias} calorías por día, con ${promedio.carbos} gramos de carbohidratos netos, ${promedio.grasas} de grasas y ${promedio.proteinas} de proteínas, contando una porción de cada una de las cuatro comidas. Cada día tiene su propio total, que en el mes va de ${Math.min(...todos.map((d) => d.calorias))} a ${Math.max(...todos.map((d) => d.calorias))} calorías.`,
      },
    },
  ],
};
---

<Layout
  titulo="Plan keto semanal con calorías y lista de compras"
  descripcion={`Siete días de dieta keto armados, con las calorías y los carbohidratos de cada comida y el total de cada día (promedio: ${promedio.calorias} calorías), más la lista de compras calculada para los que sean en tu casa.`}
  jsonld={jsonld}
>
  <h1 class="text-3xl font-bold text-hoja-700">Plan del mes</h1>
  <p class="mt-2 text-hoja-900/70 max-w-2xl leading-relaxed">
    <strong>Cuatro semanas armadas</strong> con las 49 recetas del sitio: 112 comidas, sin
    repetir ninguna dentro de la misma semana. Cada una enlaza a su receta completa, con
    los pasos y el error típico que hay que evitar, y muestra sus calorías y sus carbos
    netos por porción.
  </p>
  <p class="mt-2 text-sm text-hoja-900/55 max-w-2xl leading-relaxed">
    Las recetas no se repartieron al azar: las de una misma semana comparten verdura y
    carne, para que la compra sea más corta y sobre menos en la heladera, y lo que lleva
    más tiempo de cocina cae sábado y domingo.
  </p>

  <div class="mt-6">
    <SelectorSemana />
  </div>

  <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
    {[
      ["Calorías por día", promedio.calorias, "calorias", ""],
      ["Carbos netos", `${promedio.carbos} g`, "carbos", " g"],
      ["Grasas", `${promedio.grasas} g`, "grasas", " g"],
      ["Proteínas", `${promedio.proteinas} g`, "proteinas", " g"],
    ].map(([k, v, campo, sufijo], i) => (
      <div class="rounded-xl bg-white border border-hoja-100 p-4 text-center">
        <div
          data-promedio={campo}
          data-sufijo={sufijo}
          class:list={["text-2xl font-bold", i === 1 ? "text-naranja-600" : "text-hoja-700"]}
        >{v}</div>
        <div class="text-[11px] uppercase tracking-wide text-hoja-900/50 mt-1">{k}</div>
      </div>
    ))}
  </div>
  <p class="mt-2 text-sm text-hoja-900/50 max-w-2xl leading-relaxed">
    Promedio de los siete días, contando una porción de cada comida. Para saber si estos
    números son los tuyos, pasá por la{" "}
    <a href="/calculadora" class="text-naranja-600 hover:underline">calculadora</a>: el
    objetivo depende de tu peso, tu altura y cuánto querés bajar.
  </p>

  <div class="mt-6">
    <SelectorAyuno nota="Las comidas que se saltean quedan tachadas y no cuentan en los totales del día. La lista del súper de más abajo también se ajusta sola." />
  </div>

  <p id="aviso-porciones" class="mt-3 text-sm text-naranja-600 leading-relaxed hidden"></p>
  <p id="aviso-proteina" class="mt-2 text-sm font-medium text-naranja-700 bg-naranja-400/10 border-l-4 border-naranja-500 rounded-r-lg px-4 py-3 leading-relaxed hidden"></p>

  {semanas.map((sem, si) => (
  <div class:list={["mt-8 overflow-x-auto", si > 0 && "hidden"]} data-semana={si + 1}>
    <table class="w-full min-w-[720px] border-separate border-spacing-1">
      <thead>
        <tr>
          <th class="text-left text-sm font-semibold text-hoja-900/50 px-2 py-1">Día</th>
          {COMIDAS_DIA.map(([clave, nombre]) => (
            <th data-col={clave} class="text-left text-sm font-semibold text-hoja-900/50 px-2 py-1">
              {nombre}
            </th>
          ))}
          <th class="text-right text-sm font-semibold text-hoja-900/50 px-2 py-1">Total del día</th>
        </tr>
      </thead>
      <tbody>
        {sem.dias.map((d) => (
          <tr>
            <th scope="row" class="text-left align-top bg-hoja-600 text-crema-50 rounded-lg px-3 py-3 text-sm font-semibold whitespace-nowrap">
              {d.dia}
            </th>
            {d.comidas.map((r, ci) => (
              <td
                data-col={COMIDAS_DIA[ci][0]}
                data-cal={r ? r.macros.calorias : 0}
                data-carbos={r ? r.macros.carbos : 0}
                data-grasas={r ? r.macros.grasas : 0}
                data-proteinas={r ? r.macros.proteinas : 0}
                class="align-top bg-white border border-hoja-100 rounded-lg p-3 transition-opacity"
              >
                {r ? (
                  <a href={`/recetas/${r.slug}`} class="block group">
                    <span class="text-sm font-medium text-hoja-700 group-hover:text-naranja-600 leading-snug">
                      {r.nombre}
                    </span>
                    <span class="block mt-1 text-xs text-hoja-900/55">
                      <strong class="font-semibold text-hoja-700">{r.macros.calorias} cal</strong>
                      {" · "}{r.macros.carbos} g carbos
                    </span>
                    <span class="block text-xs text-hoja-900/40">
                      {r.minutos} min · rinde {r.porciones}
                    </span>
                    <span data-porciones class="block mt-1 text-xs font-semibold text-naranja-600 hidden"></span>
                  </a>
                ) : (
                  <span class="text-sm text-hoja-900/30">—</span>
                )}
              </td>
            ))}
            <td data-total class="align-top bg-crema-100 border border-hoja-100 rounded-lg p-3 text-right">
              <span data-total-cal class="block text-lg font-bold text-hoja-700 leading-none">{d.calorias}</span>
              <span class="block text-[11px] uppercase tracking-wide text-hoja-900/45 mt-0.5">calorías</span>
              <span data-total-carbos class="block mt-1.5 text-xs text-naranja-600 font-medium">{d.carbos} g carbos</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  ))}

  <AdSlot formato="horizontal" />

  <section class="mt-4">
    <div class="flex items-baseline justify-between flex-wrap gap-2">
      <h2 class="text-2xl font-bold text-hoja-700">Lista de compras</h2>
      <div class="flex gap-4">
        <a href="/lista-compras" class="text-sm text-naranja-600 hover:underline">Verla en página aparte →</a>
      </div>
    </div>
    <p class="mt-1 text-sm text-hoja-900/60 max-w-2xl leading-relaxed">
      La de la semana que elegiste arriba, agrupada como se recorre el súper y calculada
      para los que sean en tu casa. Lo que tildes queda guardado en este teléfono, así que
      podés ir marcando mientras comprás.
    </p>

    {semanas.map((sem, si) => (
      <div class:list={["mt-5", si > 0 && "hidden"]} data-semana={si + 1}>
        <ListaCompras compacto={true} semana={si + 1} />
      </div>
    ))}
  </section>

  <section class="mt-10 rounded-xl border-2 border-naranja-400/50 bg-naranja-400/5 p-6">
    <h2 class="text-xl font-bold text-hoja-700">Las comidas, en tu calendario</h2>
    <p class="mt-2 text-hoja-900/70 leading-relaxed max-w-2xl">
      Se pueden agendar las comidas del plan, cada una en su día y con los ingredientes
      y las calorías en la descripción del evento, más el recordatorio de la compra
      semanal. Se descarga un archivo que se importa en Google Calendar, en el Calendario
      del iPhone o en Outlook.
    </p>
    <a href="/calendario" class="inline-block mt-4 px-5 py-2.5 rounded-lg bg-hoja-600 text-crema-50 font-medium hover:bg-hoja-700 transition-colors">
      Armar mis recordatorios
    </a>
  </section>
</Layout>

<script>
  import { porId } from "../data/ayuno.js";

  /**
   * Tacha las comidas que se saltean y rehace los totales.
   *
   * La regla de fondo: **el total del día no baja**. El ayuno mueve cuándo se
   * come, no cuánto. Las porciones del plan están calculadas para cuatro
   * comidas, así que al sacar una hay que agrandar las que quedan — si no, el
   * plan avanzado cierra en 671 calorías por día, que no es ayuno intermitente
   * sino comer la mitad.
   *
   * El multiplicador se calcula **por día** y no con el promedio de la semana:
   * cada día tiene su propio total y así cada uno cierra donde cerraba.
   */
  // La tabla visible, que cambia con el selector de semana. Las cuatro están en
  // el DOM: la que manda es la que no está escondida.
  const tablaActiva = () =>
    document.querySelector("[data-semana]:not(.hidden) table");

  /** La proteína del plan completo de esta semana, para comparar contra ella.
   *
   *  Se lee de los `data-` de la tabla y no del texto del promedio en pantalla,
   *  que es justamente el número que esta función va a pisar: leerlo de ahí
   *  hacía que después de cambiar de esquema la comparación fuera contra el
   *  valor ya corregido, y el aviso desapareciera solo. */
  function baseProteina(tabla) {
    const filas = [...tabla.querySelectorAll("tbody tr")];
    if (!filas.length) return 0;
    const total = filas.reduce(
      (a, tr) => a + [...tr.querySelectorAll("td[data-col]")]
        .reduce((b, td) => b + Number(td.dataset.proteinas), 0), 0);
    return Math.round(total / filas.length);
  }

  let esquema = null;

  function aplicar(id) {
    if (id != null) esquema = id;
    const tabla = tablaActiva();
    if (!tabla) return;
    const saltea = porId(esquema).saltea;
    const BASE_PROTEINA = baseProteina(tabla);

    tabla.querySelectorAll("thead [data-col]").forEach((th) => {
      const fuera = saltea.includes(th.dataset.col);
      th.classList.toggle("line-through", fuera);
      th.classList.toggle("opacity-40", fuera);
    });

    let cal = 0, carbos = 0, grasas = 0, proteinas = 0, dias = 0;
    let mult = 1;

    tabla.querySelectorAll("tbody tr").forEach((tr) => {
      const celdas = [...tr.querySelectorAll("td[data-col]")];
      const todo = celdas.reduce((a, td) => a + +td.dataset.cal, 0);
      const quedan = celdas.reduce(
        (a, td) => a + (saltea.includes(td.dataset.col) ? 0 : +td.dataset.cal), 0);
      const f = quedan > 0 ? todo / quedan : 1;
      mult = f;

      let c = 0, cb = 0, g = 0, pr = 0;
      for (const td of celdas) {
        const fuera = saltea.includes(td.dataset.col);
        // `opacity` y no `display:none`: la tabla mantiene sus columnas y no se
        // reacomoda entera al cambiar de esquema, que marea más que ayudar.
        td.classList.toggle("opacity-30", fuera);
        td.classList.toggle("line-through", fuera);

        const badge = td.querySelector("[data-porciones]");
        if (badge) {
          badge.textContent = f > 1.05 ? `× ${f.toFixed(1)} porciones` : "";
          badge.classList.toggle("hidden", fuera || f <= 1.05);
        }
        if (fuera) continue;
        c  += +td.dataset.cal * f;
        cb += +td.dataset.carbos * f;
        g  += +td.dataset.grasas * f;
        pr += +td.dataset.proteinas * f;
      }

      const cajaCal = tr.querySelector("[data-total-cal]");
      const cajaCarbos = tr.querySelector("[data-total-carbos]");
      if (cajaCal) cajaCal.textContent = String(Math.round(c));
      if (cajaCarbos) cajaCarbos.textContent = `${Math.round(cb)} g carbos`;
      cal += c; carbos += cb; grasas += g; proteinas += pr; dias++;
    });

    if (!dias) return;
    document.querySelectorAll("[data-promedio]").forEach((el) => {
      const v = { calorias: cal, carbos, grasas, proteinas }[el.dataset.promedio];
      el.textContent = Math.round(v / dias) + (el.dataset.sufijo || "");
    });

    const aviso = document.getElementById("aviso-porciones");
    if (aviso) {
      aviso.classList.toggle("hidden", mult <= 1.05);
      aviso.textContent = mult <= 1.05 ? "" :
        `Las comidas que quedan van con porciones × ${mult.toFixed(1)}: el ayuno mueve ` +
        `cuándo comés, no cuánto. Con las porciones de siempre el día cerraría muy por ` +
        `debajo de lo que necesitás, y lo primero que se pierde ahí es músculo.`;
    }

    // Aviso de proteína. Agrandar las porciones cierra las calorías, pero no
    // necesariamente la proteína: si las comidas que quedan son las más flojas
    // en proteína, el día cierra igual de calorías y peor de músculo. Es la
    // versión concreta de lo que encontró el ensayo TREAT, y por eso se avisa
    // con el número y no con una recomendación general.
    const protAviso = document.getElementById("aviso-proteina");
    if (protAviso) {
      const prot = Math.round(proteinas / dias);
      const baja = BASE_PROTEINA - prot;
      const mostrar = saltea.length > 0 && baja >= 5;
      protAviso.classList.toggle("hidden", !mostrar);
      protAviso.textContent = !mostrar ? "" :
        `Ojo con la proteína: con este esquema el día cierra en ${prot} g en vez de ` +
        `${BASE_PROTEINA} g, porque las comidas que quedan son las más flojas en ` +
        `proteína. Sumale carne, huevo o queso a la cena — es lo que sostiene el ` +
        `músculo mientras bajás.`;
    }
  }

  document.addEventListener("keto:ayuno", (e) => aplicar(e.detail.id));
  // Al cambiar de semana hay que rehacer los totales: la tabla es otra, y los
  // promedios de arriba son los de la semana que se está mirando.
  document.addEventListener("keto:semana", () => aplicar(null));
</script>
