---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { ARTICULOS } from "../../data/evidencia.js";

export function getStaticPaths() {
  return ARTICULOS.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props;

// `citation` lleva las fuentes al grafo de datos estructurados: es lo que permite
// que un modelo de IA vea de dónde sale cada afirmación en vez de tener que
// confiar en el texto suelto.
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      headline: a.titulo,
      description: a.bajada,
      inLanguage: "es-AR",
      dateModified: a.actualizado,
      about: { "@type": "Diet", name: "Dieta cetogénica" },
      citation: a.fuentes.map((f) => ({
        "@type": "ScholarlyArticle",
        name: f.cita,
        url: f.url,
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: a.faq.map((f) => ({
        "@type": "Question",
        name: f.p,
        acceptedAnswer: { "@type": "Answer", text: f.r },
      })),
    },
  ],
};
---

<Layout titulo={a.titulo} descripcion={a.bajada} jsonld={jsonld}>
  <nav class="text-sm text-hoja-900/50 mb-4" aria-label="Miga de pan">
    <a href="/" class="hover:underline">Inicio</a> ·
    <a href="/evidencia" class="hover:underline">Evidencia</a>
  </nav>

  <article class="prosa">
    <h1 class="text-3xl md:text-4xl font-bold text-hoja-700 leading-tight">{a.titulo}</h1>
    <p class="mt-3 text-lg text-hoja-900/70 leading-relaxed">{a.bajada}</p>
    <p class="mt-2 text-sm text-hoja-900/40">
      Actualizado el {new Date(a.actualizado + "T12:00:00").toLocaleDateString("es-AR", { day: "numeric", month: "long", year: "numeric" })}
    </p>

    <div class="mt-6 rounded-xl border-l-4 border-hoja-600 bg-hoja-50 p-5">
      <p class="text-sm font-semibold uppercase tracking-wide text-hoja-600 mb-2">En resumen</p>
      <p class="text-hoja-900/85 leading-relaxed">{a.resumen_directo}</p>
    </div>

    <AdSlot formato="horizontal" />

    {a.secciones.map((s) => (
      <section class="mt-8">
        <h2 class="text-2xl font-bold text-hoja-700 mb-3">{s.titulo}</h2>
        <div class="space-y-4">
          {s.parrafos.map((p) => (
            <p class="text-hoja-900/80 leading-relaxed">{p}</p>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-hoja-700 mb-2">Fuentes</h2>
      <p class="text-sm text-hoja-900/50 mb-4">
        Todos los enlaces van a PubMed o al NCBI. Si algo de este artículo no está
        respaldado por alguna de estas fuentes, está mal y conviene avisarnos.
      </p>
      <ol class="space-y-3">
        {a.fuentes.map((f, i) => (
          <li class="flex gap-3">
            <span class="shrink-0 w-6 h-6 rounded-full bg-hoja-100 text-hoja-700 grid place-items-center text-xs font-semibold">
              {i + 1}
            </span>
            <div>
              <a href={f.url} target="_blank" rel="noopener nofollow"
                 class="text-hoja-700 hover:text-naranja-600 underline decoration-hoja-200 underline-offset-2">
                {f.cita}
              </a>
              {f.nota && <p class="text-sm text-hoja-900/50 mt-0.5">{f.nota}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-hoja-700 mb-4">Preguntas frecuentes</h2>
      <div class="space-y-3">
        {a.faq.map((f) => (
          <details class="group rounded-lg border border-hoja-100 bg-white p-4">
            <summary class="font-medium text-hoja-700 cursor-pointer list-none flex justify-between items-center gap-4">
              {f.p}
              <span class="text-naranja-500 group-open:rotate-45 transition-transform text-xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-hoja-900/70 leading-relaxed">{f.r}</p>
          </details>
        ))}
      </div>
    </section>

    <aside class="mt-10 rounded-xl bg-crema-100 border border-hoja-100 p-5">
      <p class="text-sm text-hoja-900/70 leading-relaxed">
        <strong class="text-hoja-700">Esto no es consejo médico.</strong> Es un resumen
        de literatura científica con las fuentes a la vista para que puedas leerlas por
        tu cuenta. Cualquier cambio de alimentación con medicación de por medio se
        consulta con un profesional.
      </p>
    </aside>
  </article>
</Layout>
