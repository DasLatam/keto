---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { ARTICULOS } from "../../data/evidencia.js";
---

<Layout
  titulo="Qué dice la evidencia"
  descripcion="Resúmenes de la literatura científica sobre la dieta cetogénica, con las fuentes de PubMed y NCBI a la vista. Qué está probado, qué no y cuándo consultar."
>
  <h1 class="text-3xl md:text-4xl font-bold text-hoja-700">Qué dice la evidencia</h1>
  <p class="mt-3 text-hoja-900/70 max-w-2xl leading-relaxed">
    Resúmenes de estudios sobre la dieta cetogénica con <strong>los enlaces a la
    fuente original</strong>, para que puedas leerla por tu cuenta. Incluye lo que
    está bien documentado y también lo que no está probado, que es la parte que
    casi nadie cuenta.
  </p>

  <div class="mt-8 grid gap-4">
    {ARTICULOS.map((a) => (
      <a href={`/evidencia/${a.slug}`}
         class="group rounded-xl border border-hoja-100 bg-white p-6 hover:border-hoja-500 hover:shadow-lg transition-all">
        <h2 class="font-semibold text-xl text-hoja-700 group-hover:text-naranja-600 leading-snug">
          {a.titulo}
        </h2>
        <p class="mt-2 text-hoja-900/70 leading-relaxed">{a.bajada}</p>
        <p class="mt-3 text-sm text-hoja-900/40">
          {a.fuentes.length} fuentes citadas · actualizado el{" "}
          {new Date(a.actualizado + "T12:00:00").toLocaleDateString("es-AR", { day: "numeric", month: "long", year: "numeric" })}
        </p>
      </a>
    ))}
  </div>

  <AdSlot formato="horizontal" />
</Layout>
