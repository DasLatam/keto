---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import RecetaCard from "../components/RecetaCard.astro";
import { PRODUCTOS } from "../data/productos.js";
import { TRUCOS } from "../data/cocina.js";
import { AUDIOS } from "../data/audios.js";
import MediosIndice from "../components/MediosIndice.astro";
import { RECETAS } from "../data/recetas.js";

const destacadas = RECETAS.filter((r) => r.etiquetas.includes("15min")).slice(0, 3);

// Las preguntas frecuentes cumplen doble función: le sirven al que llega, y son
// lo que Google y los modelos de IA citan como respuesta directa. Por eso van
// también en JSON-LD y no sólo como HTML.
const FAQ = [
  {
    p: "¿Se puede hacer keto en Argentina sin gastar una fortuna?",
    r: "Sí. La base de la dieta —huevos, carne, queso, verduras de hoja, aceite— es comida de todos los días. Lo caro son los productos «keto» importados, que no hacen falta. Los cortes con más grasa, que en keto son los mejores, suelen ser los más baratos de la carnicería.",
  },
  {
    p: "¿Cuántos carbohidratos por día son «keto»?",
    r: "El rango habitual es de 20 a 50 gramos de carbohidratos netos por día. Los carbos netos son los carbohidratos totales menos la fibra. Cuanto más bajo, más rápido entra el cuerpo en cetosis, pero también cuesta más sostenerlo.",
  },
  {
    p: "¿Puedo tomar mate en keto?",
    r: "Sí, el mate amargo no tiene carbohidratos. El problema es el azúcar: un mate dulce puede sumar más carbos que una comida entera. Si necesitás endulzarlo, va con stevia o eritritol.",
  },
  {
    p: "¿Qué es la «gripe keto» y cómo se evita?",
    r: "Los primeros días pueden aparecer dolor de cabeza, cansancio y calambres. Casi siempre es falta de agua y de sal: al bajar los carbos, el cuerpo elimina más líquido y con él sodio, potasio y magnesio. Tomar más agua y salar bien la comida suele resolverlo.",
  },
  {
    p: "¿Se puede comer asado en keto?",
    r: "El asado es de las comidas más compatibles que hay. Carne, achuras y chorizo puro entran sin problema. Lo que queda afuera es el pan, la ensalada de papa y las salsas dulces como la barbacoa.",
  },
];

const totalTrucos = TRUCOS.reduce((n, g) => n + g.items.length, 0);
const minutosAudio = Math.round(AUDIOS.reduce((n, a) => n + a.minutos, 0));

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Keto Argentina",
      url: "https://ketofacil.vercel.app",
      inLanguage: "es-AR",
    },
    {
      "@type": "FAQPage",
      mainEntity: FAQ.map((f) => ({
        "@type": "Question",
        name: f.p,
        acceptedAnswer: { "@type": "Answer", text: f.r },
      })),
    },
  ],
};
---

<Layout
  titulo="Dieta keto en Argentina"
  descripcion="Guía práctica de dieta keto con productos que se consiguen en Argentina: recetas, plan semanal, qué comprar en Coto o Carrefour y calculadora de macros."
  jsonld={jsonld}
>
  <section class="text-center py-8 md:py-14">
    <h1 class="text-3xl md:text-5xl font-bold text-hoja-700 leading-tight">
      Dieta keto, sin adivinar nada
    </h1>
    <p class="mt-4 text-lg text-hoja-900/70 max-w-2xl mx-auto">
      Las recetas con sus macros, la semana ya armada, la lista del súper calculada
      para los que sean en tu casa y los audios para hacer los ejercicios sin mirar el
      reloj. Todo verificado: los números cierran o no se publican.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a
        href="/como-empezar"
        class="px-6 py-3 rounded-lg bg-hoja-600 text-crema-50 font-medium hover:bg-hoja-700 transition-colors"
      >
        Empezar en 7 días
      </a>
      <a
        href="/plan-semanal"
        class="px-6 py-3 rounded-lg border-2 border-hoja-600 text-hoja-700 font-medium hover:bg-hoja-600 hover:text-crema-50 transition-colors"
      >
        Ver el plan de la semana
      </a>
      <a
        href="/calculadora"
        class="px-6 py-3 rounded-lg border-2 border-naranja-500 text-naranja-600 font-medium hover:bg-naranja-500 hover:text-white transition-colors"
      >
        Calcular mis macros
      </a>
    </div>
  </section>

  {/* Las cifras salen de los datos, no están escritas: si mañana hay 60 recetas
      el número cambia solo. Un "más de 40 recetas" escrito a mano envejece mal y
      queda mintiendo por lo bajo. */}
  <section class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {[
      [RECETAS.length, "recetas", "con sus macros", "/recetas"],
      [PRODUCTOS.length, "ingredientes", "cómo elegirlos y guardarlos", "/productos"],
      [totalTrucos, "trucos de cocina", "por qué falla lo que falla", "/trucos"],
      [minutosAudio, "minutos de audio", "para caminar y entrenar", "/ejercicios"],
    ].map(([n, t, d, href]) => (
      <a href={href} class="rounded-xl border border-hoja-100 bg-white p-4 text-center hover:border-hoja-500 transition-colors">
        <div class="text-3xl font-bold text-hoja-700">{n}</div>
        <div class="text-sm font-medium text-hoja-900/75">{t}</div>
        <div class="text-xs text-hoja-900/45 leading-snug mt-0.5">{d}</div>
      </a>
    ))}
  </section>

  <AdSlot formato="horizontal" />

  <section class="py-6">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-2xl font-bold text-hoja-700">Rápidas, en 15 minutos</h2>
      <a href="/recetas" class="text-sm text-naranja-600 hover:underline">Ver todas →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {destacadas.map((r) => <RecetaCard receta={r} />)}
    </div>
  </section>

  <section class="py-8 grid gap-4 md:grid-cols-3">
    {[
      { icono: "🛒", titulo: "Lista del súper", texto: "La compra de la semana entera, agrupada por sector y con las cantidades calculadas para los que sean en tu casa.", href: "/lista-compras" },
      { icono: "📋", titulo: "Plan semanal", texto: "Siete días armados con 28 recetas distintas, con las calorías y los carbos de cada comida y el total de cada día.", href: "/plan-semanal" },
      { icono: "🧮", titulo: "Calculadora", texto: "Tus gramos de grasa, proteína y carbos según peso, altura y objetivo.", href: "/calculadora" },
      { icono: "💪", titulo: "Ejercicios", texto: "Elongación cada mañana, caminata de 40 minutos y fuerza con una silla, la pared y una banda elástica. Sin gimnasio.", href: "/ejercicios" },
      { icono: "📅", titulo: "Calendario", texto: "Agendá las rutinas, las comidas y la compra semanal, con los avisos puestos, en Google Calendar o en el iPhone.", href: "/calendario" },
      { icono: "🏷", titulo: "Qué comprar", texto: "Los 37 ingredientes uno por uno: por qué entra o no, cómo elegirlo en la góndola, cómo se guarda y cuál es el error típico.", href: "/productos" },
      { icono: "⏳", titulo: "Ayuno intermitente", texto: "Dos esquemas sobre el mismo plan: sin desayuno, o sin desayuno ni almuerzo. Con lo que dice la evidencia y lo que no dice.", href: "/ayuno-intermitente" },
      { icono: "🔥", titulo: "Trucos de cocina", texto: "Por qué la carne queda gris, por qué el revuelto sale seco y por qué la masa de almendras se desarma.", href: "/trucos" },
      { icono: "❄️", titulo: "Congelar", texto: "Qué aguanta el freezer y qué no, cuánto dura cada cosa y cómo descongelarla sin que suelte todo el líquido.", href: "/congelar" },
      { icono: "🎧", titulo: "Audios guía", texto: "Las rutinas en tiempo real —cuando la voz se calla, hacés el ejercicio— y cuatro caminatas que repasan el sitio entero.", href: "/ejercicios" },
    ].map((c) => (
      <a href={c.href} class="rounded-xl border border-hoja-100 bg-white p-6 hover:border-hoja-500 hover:shadow-lg transition-all">
        <div class="text-3xl">{c.icono}</div>
        <h3 class="mt-3 font-semibold text-lg text-hoja-700">{c.titulo}</h3>
        <p class="mt-1 text-sm text-hoja-900/60 leading-relaxed">{c.texto}</p>
      </a>
    ))}
  </section>

  <AdSlot formato="rectangulo" />

  <section class="py-8 prosa">
    <h2 class="text-2xl font-bold text-hoja-700 mb-6">Preguntas frecuentes</h2>
    <div class="space-y-3">
      {FAQ.map((f) => (
        <details class="group rounded-lg border border-hoja-100 bg-white p-4">
          <summary class="font-medium text-hoja-700 cursor-pointer list-none flex justify-between items-center gap-4">
            {f.p}
            <span class="text-naranja-500 group-open:rotate-45 transition-transform text-xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-hoja-900/70 leading-relaxed">{f.r}</p>
        </details>
      ))}
    </div>
  </section>
  <MediosIndice />
</Layout>
