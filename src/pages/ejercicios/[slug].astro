---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import AudioGuia from "../../components/AudioGuia.astro";
import { RUTINAS, caloriasPorSesion, sesionesSemanales } from "../../data/ejercicios.js";

export function getStaticPaths() {
  return RUTINAS.map((rutina) => ({ params: { slug: rutina.slug }, props: { rutina } }));
}

const { rutina } = Astro.props;
const {
  slug, nombre, emoji, frecuencia, dias, duracion, intensidad, met,
  resumen, veredicto, elementos, cuando, bloques, progresion, faq,
} = rutina;

const PESO_REF = 80;
const otras = RUTINAS.filter((r) => r.slug !== slug);
const totalEjercicios = bloques.reduce((n, b) => n + b.ejercicios.length, 0);

const miga = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Ejercicios", item: new URL("/ejercicios", Astro.site).href },
    { "@type": "ListItem", position: 3, name: nombre },
  ],
};

// `ExercisePlan` es el tipo que schema.org tiene para esto y acepta frecuencia,
// duración e intensidad como campos propios. Se acompaña con `HowTo`, que es el
// que Google entiende para mostrar los pasos: los dos describen lo mismo, uno
// para buscadores y otro para modelos de IA que buscan la ficha estructurada.
const plan_ld = {
  "@type": "ExercisePlan",
  name: nombre,
  description: veredicto,
  inLanguage: "es-AR",
  activityFrequency: frecuencia,
  activityDuration: `PT${duracion}M`,
  intensity: intensidad,
  exerciseType: bloques.map((b) => b.nombre).join(", "),
};

const howto_ld = {
  "@type": "HowTo",
  name: nombre,
  description: resumen,
  totalTime: `PT${duracion}M`,
  tool: elementos.map((e) => ({ "@type": "HowToTool", name: e })),
  step: bloques.map((b) => ({
    "@type": "HowToSection",
    name: b.nombre,
    itemListElement: b.ejercicios.map((e, i) => ({
      "@type": "HowToStep",
      position: i + 1,
      name: e.nombre,
      text: `${e.como} ${e.tip}`,
    })),
  })),
};

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    plan_ld,
    howto_ld,
    miga,
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.p,
        acceptedAnswer: { "@type": "Answer", text: f.r },
      })),
    },
  ],
};
---

<Layout
  titulo={nombre}
  descripcion={`${resumen} ${totalEjercicios} ejercicios, ${duracion} minutos, ${frecuencia.toLowerCase()}.`}
  jsonld={jsonld}
>
  <nav class="text-sm text-hoja-900/50 mb-4" aria-label="Miga de pan">
    <a href="/" class="hover:underline">Inicio</a> ·{" "}
    <a href="/ejercicios" class="hover:underline">Ejercicios</a>
  </nav>

  <article class="prosa">
    <div class="flex items-start gap-4">
      <span class="text-5xl shrink-0" aria-hidden="true">{emoji}</span>
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-hoja-700 leading-tight">{nombre}</h1>
        <p class="mt-2 text-hoja-900/60">
          {frecuencia} · {duracion} minutos · {totalEjercicios} ejercicios
        </p>
      </div>
    </div>

    {/* El veredicto arriba de todo: es la respuesta directa que un modelo de IA
        extrae para citar, y de paso le dice al que llega si esta rutina es la que
        buscaba sin tener que leer los cuatro bloques. */}
    <p class="mt-5 text-lg text-hoja-900/80 leading-relaxed border-l-4 border-hoja-500 pl-4">
      {veredicto}
    </p>

    <AudioGuia slug={slug} />

    <div class="mt-6 grid sm:grid-cols-2 gap-4">
      <section class="rounded-xl border border-hoja-100 bg-white p-5">
        <h2 class="font-semibold text-hoja-700">Qué hace falta</h2>
        <ul class="mt-3 space-y-1.5">
          {elementos.map((e) => (
            <li class="flex gap-2 text-sm text-hoja-900/75">
              <span class="text-hoja-500 shrink-0" aria-hidden="true">✓</span>
              <span>{e}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="rounded-xl border border-hoja-100 bg-white p-5">
        <h2 class="font-semibold text-hoja-700">Cuándo</h2>
        <p class="mt-2 text-sm text-hoja-900/75 leading-relaxed">{cuando}</p>
        <p class="mt-3 text-sm">
          <a href="/calendario" class="text-naranja-600 hover:underline font-medium">
            Agendar los avisos →
          </a>
        </p>
      </section>
    </div>

    {/* Calculadora de calorías: el número sirve sólo si es con el peso de cada
        uno. Con un valor fijo, la mitad de los lectores lee un dato que no es el
        suyo y se lo cree igual. */}
    <section class="mt-4 rounded-xl border border-hoja-100 bg-white p-5">
      <h2 class="font-semibold text-hoja-700">Cuántas calorías quema, con tu peso</h2>
      <div class="mt-3 flex flex-wrap items-end gap-4">
        <label class="block">
          <span class="text-sm text-hoja-900/60">Tu peso (kg)</span>
          <input
            type="number" id="peso" value={PESO_REF} min="35" max="250" step="0.5"
            class="mt-1 w-28 rounded-lg border border-hoja-200 px-3 py-2 focus:border-hoja-500 focus:outline-none"
          />
        </label>
        <div class="flex gap-3">
          <div class="rounded-lg bg-crema-100 px-4 py-2 text-center">
            <div class="text-[11px] uppercase tracking-wide text-hoja-900/50">Por sesión</div>
            <strong id="kcalSesion" class="text-2xl text-hoja-700">{caloriasPorSesion(rutina, PESO_REF)}</strong>
          </div>
          <div class="rounded-lg bg-crema-100 px-4 py-2 text-center">
            <div class="text-[11px] uppercase tracking-wide text-hoja-900/50">Por semana</div>
            <strong id="kcalSemana" class="text-2xl text-hoja-700">
              {caloriasPorSesion(rutina, PESO_REF) * sesionesSemanales(rutina)}
            </strong>
          </div>
        </div>
      </div>
      <p class="mt-3 text-xs text-hoja-900/50 leading-relaxed">
        Fórmula estándar <strong>MET × kilos × horas</strong>: esta rutina son{" "}
        <strong>{met.toString().replace(".", ",")} MET</strong> durante {duracion} minutos,
        {" "}{sesionesSemanales(rutina)} {sesionesSemanales(rutina) === 1 ? "vez" : "veces"} por semana.
        Es una estimación de tabla, con el mismo margen de error que los macros de las
        recetas: sirve para ordenar la semana, no para cuadrar un número al gramo.
      </p>
    </section>

    <AdSlot formato="horizontal" />

    <h2 class="text-2xl font-bold text-hoja-700 mt-4 mb-1">La rutina, paso por paso</h2>
    <p class="text-sm text-hoja-900/60 mb-6">
      En orden. Cada ejercicio lleva el error típico: es lo que separa un ejercicio que
      sirve de uno que no hace nada o que lastima.
    </p>

    <div class="space-y-8">
      {bloques.map((b, bi) => (
        <section>
          <h3 class="text-xl font-bold text-hoja-700 flex items-baseline gap-2">
            <span class="text-sm font-normal text-hoja-900/35 shrink-0">
              Bloque {bi + 1}
            </span>
            {b.nombre}
          </h3>
          <p class="mt-1 text-sm text-hoja-900/60 leading-relaxed">{b.nota}</p>

          <ol class="mt-4 space-y-3">
            {b.ejercicios.map((e, ei) => (
              <li class="rounded-xl border border-hoja-100 bg-white p-5">
                <div class="flex items-start gap-3">
                  <span class="shrink-0 w-7 h-7 rounded-full bg-hoja-600 text-crema-50 grid place-items-center text-sm font-semibold">
                    {ei + 1}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-3 flex-wrap">
                      <h4 class="font-semibold text-hoja-700">{e.nombre}</h4>
                      <span class="text-sm font-medium text-naranja-600 whitespace-nowrap">{e.dosis}</span>
                    </div>
                    <p class="mt-0.5 text-[11px] uppercase tracking-wide text-hoja-900/40">{e.zona}</p>
                    <p class="mt-2 text-hoja-900/80 leading-relaxed">{e.como}</p>
                    <p class="mt-2.5 text-sm text-hoja-900/70 leading-relaxed border-l-2 border-naranja-500 pl-3">
                      <strong class="text-naranja-600">El error típico:</strong> {e.tip}
                    </p>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-hoja-700">Cómo progresar</h2>
      <p class="mt-1 text-sm text-hoja-900/60">
        Hacer siempre lo mismo deja de dar resultado en unas semanas. Estas son las tres
        etapas, en orden.
      </p>
      <ol class="mt-4 space-y-3">
        {progresion.map((p, i) => (
          <li class="flex gap-3 rounded-xl bg-crema-100 border border-hoja-100 p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-naranja-500 text-white grid place-items-center text-sm font-semibold">
              {i + 1}
            </span>
            <p class="text-hoja-900/80 leading-relaxed pt-0.5">{p}</p>
          </li>
        ))}
      </ol>
    </section>

    <AdSlot formato="rectangulo" />

    <section class="mt-4">
      <h2 class="text-2xl font-bold text-hoja-700 mb-4">Preguntas frecuentes</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="group rounded-lg border border-hoja-100 bg-white p-4">
            <summary class="font-medium text-hoja-700 cursor-pointer list-none flex justify-between items-center gap-4">
              {f.p}
              <span class="text-naranja-500 group-open:rotate-45 transition-transform text-xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-hoja-900/70 leading-relaxed">{f.r}</p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-hoja-700 mb-1">Las otras dos rutinas</h2>
    <p class="text-sm text-hoja-900/60 mb-4">
      Las tres están pensadas para hacerse juntas: una sola no cubre la semana.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {otras.map((r) => (
        <a href={`/ejercicios/${r.slug}`} class="rounded-xl border border-hoja-100 bg-white p-5 hover:border-hoja-500 hover:shadow-lg transition-all">
          <div class="text-3xl" aria-hidden="true">{r.emoji}</div>
          <h3 class="mt-2 font-semibold text-hoja-700">{r.nombre}</h3>
          <p class="mt-1 text-sm text-hoja-900/60">{r.frecuencia} · {r.duracion} min</p>
        </a>
      ))}
    </div>
  </section>

  <div class="mt-8 flex flex-wrap gap-4">
    <a href="/ejercicios" class="text-naranja-600 hover:underline">← Todas las rutinas</a>
    <a href="/calendario" class="text-naranja-600 hover:underline">Agendar los recordatorios →</a>
  </div>
</Layout>

<script define:vars={{ met, duracion, sesiones: sesionesSemanales(rutina) }}>
  // Recalcula las calorías con el peso que se escriba. La fórmula es la misma que
  // en `caloriasPorSesion()` de src/data/ejercicios.js — está duplicada porque en
  // el cliente sólo hacen falta tres números y no vale traer el módulo entero.
  const peso = document.getElementById("peso");
  const porSesion = document.getElementById("kcalSesion");
  const porSemana = document.getElementById("kcalSemana");

  function calcular() {
    const kg = Number(peso.value);
    if (!kg || kg < 20) return;
    const sesion = Math.round(met * kg * (duracion / 60));
    porSesion.textContent = sesion;
    porSemana.textContent = sesion * sesiones;
  }

  peso.addEventListener("input", calcular);
</script>
