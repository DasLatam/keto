---
/**
 * Selector de semana del mes.
 *
 * Aparece en `/plan-semanal` y en `/lista-compras`, y en las dos hace lo mismo:
 * muestra la sección `[data-semana="N"]` elegida y esconde las otras. Las cuatro
 * semanas salen renderizadas del build —son HTML estático, no cuestan nada— así
 * que cambiar de semana es instantáneo y funciona sin volver a pedir la página.
 *
 * La elección se guarda y **se comparte entre las dos páginas**: quien está
 * comprando la semana 3 y salta al plan quiere ver la semana 3, no volver a la 1.
 *
 * Sin JavaScript se ve la semana 1 y nada más. Es un plan de comidas: la primera
 * semana sola ya sirve.
 */
import { SEMANAS } from "../data/recetas.js";

const { etiqueta = "Semana del mes" } = Astro.props;
---

<div class="rounded-xl border border-hoja-100 bg-white p-4" data-selector-semana>
  <div class="flex items-baseline justify-between gap-3 flex-wrap">
    <span class="text-sm font-medium text-hoja-700">{etiqueta}</span>
    <span data-titulo-semana class="text-sm text-hoja-900/50">{SEMANAS[0].titulo}</span>
  </div>
  <div class="mt-3 grid grid-cols-4 gap-2" role="tablist">
    {SEMANAS.map((s, i) => (
      <button
        type="button"
        role="tab"
        data-semana-btn={i + 1}
        aria-selected={i === 0}
        class="px-2 py-2.5 rounded-lg border text-sm font-medium transition-colors
               aria-selected:bg-hoja-600 aria-selected:text-crema-50 aria-selected:border-hoja-600
               border-hoja-200 text-hoja-700 hover:bg-hoja-50"
      >
        {i + 1}
      </button>
    ))}
  </div>
  <p data-nota-semana class="mt-3 text-sm text-hoja-900/60 leading-relaxed">
    {SEMANAS[0].nota}
  </p>
</div>

<script>
  import { SEMANAS } from "../data/recetas.js";

  const CLAVE = "keto-semana";
  const MAX = SEMANAS.length;

  function leer() {
    const n = Number(localStorage.getItem(CLAVE));
    return n >= 1 && n <= MAX ? n : 1;
  }

  function aplicar(n, guardar = true) {
    // Las secciones viven fuera del selector —la tabla del plan, cada lista del
    // súper—, así que se buscan en el documento entero y no acá adentro.
    for (const el of document.querySelectorAll("[data-semana]")) {
      el.classList.toggle("hidden", Number(el.dataset.semana) !== n);
    }
    for (const raiz of document.querySelectorAll("[data-selector-semana]")) {
      for (const btn of raiz.querySelectorAll("[data-semana-btn]")) {
        btn.setAttribute("aria-selected", String(Number(btn.dataset.semanaBtn) === n));
      }
      const s = SEMANAS[n - 1];
      const t = raiz.querySelector("[data-titulo-semana]");
      const nota = raiz.querySelector("[data-nota-semana]");
      if (t) t.textContent = s.titulo;
      if (nota) nota.textContent = s.nota;
    }
    if (guardar) {
      try {
        localStorage.setItem(CLAVE, String(n));
      } catch {
        /* almacenamiento bloqueado: la semana no se recuerda, todo lo demás anda */
      }
    }
    document.dispatchEvent(new CustomEvent("keto:semana", { detail: { semana: n } }));
  }

  for (const raiz of document.querySelectorAll("[data-selector-semana]")) {
    for (const btn of raiz.querySelectorAll("[data-semana-btn]")) {
      btn.addEventListener("click", () => aplicar(Number(btn.dataset.semanaBtn)));
    }
  }

  aplicar(leer(), false);
</script>
