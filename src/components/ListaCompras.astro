---
// La lista del súper con el selector de cantidad de personas. Vive en un
// componente porque aparece en dos lados —`/lista-compras` y embebida en
// `/plan-semanal`— y las dos tienen que escalar igual y compartir los tildes.
//
// El escalado se hace en el cliente, no en el build: el HTML sale renderizado
// para una persona y el JavaScript lo reescribe con el número guardado. Así la
// página sigue siendo estática y cacheable, y quien tenga el JS bloqueado ve la
// lista para una persona en lugar de no ver nada.
import { LISTA_COMPRAS, PLAN_SEMANAL, RECETAS } from "../data/recetas.js";
import { textoItem, claveItem, cuentaEscalables } from "../lib/porciones.js";
import { COMIDAS_PLAN } from "../data/ayuno.js";

// Calorías promedio de cada comida en el plan. Van al HTML como dato para que el
// navegador pueda calcular cuánto hay que agrandar las comidas que quedan cuando
// se saltea alguna: el ayuno mueve cuándo se come, no cuánto, así que la lista
// del súper **no** baja en proporción a las comidas salteadas.
const porSlug = Object.fromEntries(RECETAS.map((r) => [r.slug, r]));
const CAL_COMIDA = Object.fromEntries(
  COMIDAS_PLAN.map((c) => [
    c,
    Math.round(
      PLAN_SEMANAL.reduce((a, d) => a + (porSlug[d[c]]?.macros.calorias ?? 0), 0) /
        PLAN_SEMANAL.length,
    ),
  ]),
);

const { titulo = null, compacto = false } = Astro.props;

const totalItems = LISTA_COMPRAS.reduce((n, s) => n + s.items.length, 0);
---

<div class="lista-compras" data-lista data-cal-comida={JSON.stringify(CAL_COMIDA)}>
  <div class="flex flex-wrap items-center gap-3 gap-y-4">
    {/* El selector es lo primero: si aparece debajo de la lista, la gente copia
        las cantidades para una persona sin enterarse de que se podían escalar. */}
    <div class="flex items-center gap-2 rounded-xl border border-hoja-100 bg-white px-3 py-2">
      <span class="text-sm font-medium text-hoja-700">Somos</span>
      <button
        type="button" data-personas="-1"
        class="w-9 h-9 rounded-lg border border-hoja-200 text-hoja-700 text-xl leading-none hover:bg-hoja-50 disabled:opacity-30"
        aria-label="Una persona menos"
      >−</button>
      <output data-salida-personas class="w-8 text-center text-xl font-bold text-hoja-700">1</output>
      <button
        type="button" data-personas="1"
        class="w-9 h-9 rounded-lg border border-hoja-200 text-hoja-700 text-xl leading-none hover:bg-hoja-50 disabled:opacity-30"
        aria-label="Una persona más"
      >+</button>
      <span data-etiqueta-personas class="text-sm text-hoja-900/50">persona</span>
    </div>

    <span data-progreso class="text-sm font-medium text-hoja-700 bg-hoja-100 px-3 py-1.5 rounded-full">
      0 de {totalItems}
    </span>
    <button type="button" data-limpiar class="text-sm text-naranja-600 hover:underline">Destildar todo</button>
    {!compacto && (
      <button type="button" data-imprimir class="text-sm text-naranja-600 hover:underline">Imprimir</button>
    )}
  </div>

  <p class="mt-2 text-sm text-hoja-900/50 max-w-2xl leading-relaxed">
    Lo que tildes queda guardado en este teléfono: podés ir marcando mientras comprás,
    cerrar y volver. <span data-aviso-escala class="hidden">
      Los frascos, botellas y condimentos <strong>no se multiplican</strong>: rinden varias
      semanas igual para uno que para seis.
    </span>
  </p>

  {/* Aviso de lo que el ayuno saca de la lista. Sale vacío del build y lo llena
      el JavaScript: sin ayuno no sobra nada y el aviso no aparece. */}
  <p data-aviso-ayuno class="mt-2 text-sm text-naranja-600 leading-relaxed hidden"></p>

  {titulo && <h2 class="mt-6 text-2xl font-bold text-hoja-700">{titulo}</h2>}

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {LISTA_COMPRAS.map((s) => (
      <section class="rounded-xl border border-hoja-100 bg-white p-5 break-inside-avoid">
        <h3 class="font-semibold text-hoja-700 mb-3 flex items-baseline justify-between gap-2">
          {s.sector}
          <span class="text-xs font-normal text-hoja-900/40">{s.items.length}</span>
        </h3>
        <ul class="space-y-2.5">
          {s.items.map((item) => (
            <li data-fila>
              <label class="flex items-start gap-3 cursor-pointer group">
                {/* La clave del tilde no lleva la cantidad: si la llevara, mover
                    el selector de personas cambiaría la clave y se destildaría
                    todo lo que ya estaba marcado. */}
                <input
                  type="checkbox" class="compra mt-0.5 w-5 h-5 rounded accent-hoja-600 shrink-0"
                  data-item={claveItem(s.sector, item)}
                />
                <span
                  class="text-hoja-900/80 group-has-checked:line-through group-has-checked:text-hoja-900/35 transition-colors"
                  data-texto
                  data-cant={item.cant ?? ""}
                  data-unidad={item.unidad ?? ""}
                  data-nombre={item.nombre ?? ""}
                  data-escala={item.escala === false ? "no" : "si"}
                  data-usos={JSON.stringify(item.usos ?? null)}
                >
                  {textoItem(item, 1)}
                </span>
              </label>
            </li>
          ))}
        </ul>
        {cuentaEscalables(s.items) === 0 && (
          <p class="mt-3 text-xs text-hoja-900/45 leading-relaxed">
            Nada de este sector se multiplica: son los mismos envases para uno o para seis.
          </p>
        )}
      </section>
    ))}
  </div>
</div>

<script>
  import { textoItem } from "../lib/porciones.js";
  import { factorLista, factorPorcion, porId } from "../data/ayuno.js";

  // Misma clave en las dos páginas que muestran la lista: si alguien tilda en
  // /plan-semanal y abre /lista-compras, ve lo mismo. Dos listas con estados
  // distintos serían peor que no guardar nada.
  const CLAVE_TILDES = "keto-lista-compras";
  // Compartida con /calendario, que la usa para el recordatorio de la compra.
  const CLAVE_PERSONAS = "keto-personas";
  const MAX_PERSONAS = 12;

  for (const raiz of document.querySelectorAll("[data-lista]")) {
    const cajas = [...raiz.querySelectorAll(".compra")];
    const textos = [...raiz.querySelectorAll("[data-texto]")];
    const progreso = raiz.querySelector("[data-progreso]");
    const salida = raiz.querySelector("[data-salida-personas]");
    const etiqueta = raiz.querySelector("[data-etiqueta-personas]");
    const aviso = raiz.querySelector("[data-aviso-escala]");

    let personas = Number(localStorage.getItem(CLAVE_PERSONAS)) || 1;
    personas = Math.min(MAX_PERSONAS, Math.max(1, personas));

    // Arranca en lo guardado y no en "sin ayuno": si no, al entrar a la lista se
    // vería un instante la cantidad completa antes de corregirse.
    let saltea = porId(localStorage.getItem("keto-ayuno")).saltea;
    const avisoAyuno = raiz.querySelector("[data-aviso-ayuno]");
    let calComida = {};
    try {
      calComida = JSON.parse(raiz.dataset.calComida || "{}");
    } catch {
      calComida = {};
    }

    let guardado = {};
    try {
      guardado = JSON.parse(localStorage.getItem(CLAVE_TILDES) ?? "{}");
    } catch {
      guardado = {};
    }

    /**
     * Reescribe las cantidades para `personas` personas y el ayuno elegido.
     *
     * El ayuno entra como una fracción sobre `cant` antes de multiplicar por las
     * personas: salteando el desayuno no desaparecen los huevos, quedan los que
     * van en las otras comidas. Ver `factorLista` en `data/ayuno.js`.
     */
    function escalar() {
      let fuera = 0;

      for (const el of textos) {
        const cant = el.dataset.cant === "" ? null : Number(el.dataset.cant);
        let usos = null;
        try {
          usos = JSON.parse(el.dataset.usos || "null");
        } catch {
          usos = null;
        }
        const item = {
          cant,
          unidad: el.dataset.unidad || null,
          nombre: el.dataset.nombre || null,
          escala: el.dataset.escala === "no" ? false : true,
          usos,
        };

        // El multiplicador es lo que evita que la lista pida comida para 671
        // calorías por día: si se saltean dos comidas, las otras dos se cocinan
        // el doble de grandes y sus ingredientes rinden la mitad.
        const factor = factorLista(item, saltea, factorPorcion(calComida, saltea));
        const fila = el.closest("[data-fila]");

        if (factor === 0) {
          // Este ítem sólo servía para comidas que se saltean. Se oculta en vez
          // de mostrarlo en cero: "0 paltas" en una lista del súper no es un
          // dato, es ruido.
          fila?.classList.add("hidden");
          fuera++;
          continue;
        }
        fila?.classList.remove("hidden");
        el.textContent = textoItem({ ...item, cant: cant == null ? null : cant * factor }, personas);
      }

      if (avisoAyuno) {
        avisoAyuno.classList.toggle("hidden", fuera === 0);
        const mult = factorPorcion(calComida, saltea);
        const cola = mult > 1.05
          ? ` Las comidas que quedan van con porciones × ${mult.toFixed(1)}, así que del resto se compra casi lo mismo: el ayuno mueve cuándo comés, no cuánto.`
          : "";
        avisoAyuno.textContent = fuera === 0 ? "" :
          (fuera === 1
            ? "Con este ayuno, 1 ítem sale de la lista."
            : `Con este ayuno, ${fuera} ítems salen de la lista.`) + cola;
      }

      salida.textContent = String(personas);
      etiqueta.textContent = personas === 1 ? "persona" : "personas";
      aviso.classList.toggle("hidden", personas === 1);

      for (const btn of raiz.querySelectorAll("[data-personas]")) {
        const paso = Number(btn.dataset.personas);
        btn.disabled = personas + paso < 1 || personas + paso > MAX_PERSONAS;
      }
    }

    function pintarProgreso() {
      const n = cajas.filter((c) => c.checked).length;
      progreso.textContent = `${n} de ${cajas.length}`;
      progreso.classList.toggle("bg-hoja-600", n === cajas.length);
      progreso.classList.toggle("text-crema-50", n === cajas.length);
      progreso.classList.toggle("bg-hoja-100", n !== cajas.length);
    }

    function persistirTildes() {
      const estado = {};
      for (const c of cajas) if (c.checked) estado[c.dataset.item] = true;
      try {
        localStorage.setItem(CLAVE_TILDES, JSON.stringify(estado));
      } catch {
        /* almacenamiento bloqueado: la lista funciona, no recuerda */
      }
      pintarProgreso();
    }

    document.addEventListener("keto:ayuno", (e) => {
      saltea = porId(e.detail.id).saltea;
      escalar();
    });

    for (const c of cajas) {
      c.checked = Boolean(guardado[c.dataset.item]);
      c.addEventListener("change", persistirTildes);
    }

    for (const btn of raiz.querySelectorAll("[data-personas]")) {
      btn.addEventListener("click", () => {
        personas = Math.min(MAX_PERSONAS, Math.max(1, personas + Number(btn.dataset.personas)));
        try {
          localStorage.setItem(CLAVE_PERSONAS, String(personas));
        } catch {
          /* ídem */
        }
        escalar();
        // El resto de la página necesita enterarse: la sección "qué se cocina
        // con todo esto" muestra lo que rinde cada receta, y con tres personas
        // "rinde 1" contradice a la lista que acaba de triplicar las cantidades.
        document.dispatchEvent(
          new CustomEvent("keto:personas", { detail: { personas } }),
        );
      });
    }

    raiz.querySelector("[data-limpiar]")?.addEventListener("click", () => {
      for (const c of cajas) c.checked = false;
      persistirTildes();
    });
    raiz.querySelector("[data-imprimir]")?.addEventListener("click", () => window.print());

    escalar();
    pintarProgreso();
    document.dispatchEvent(new CustomEvent("keto:personas", { detail: { personas } }));
  }
</script>
