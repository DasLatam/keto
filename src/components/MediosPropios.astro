---
/**
 * Bloque «De la cocina de Ariel»: las fotos y videos que se suben desde el panel
 * (https://www.baudry.com.ar/keto-panel/), más los enlaces de YouTube.
 *
 * Se llena **en el navegador**, no en el build, y ésa es la decisión de fondo:
 * el sitio es estático y se despliega desde git, así que una foto sacada en la
 * cocina tardaría un build y un push en verse. Pidiéndolo por fetch aparece en
 * cuanto se sube. Es el mismo trato que el contador.
 *
 * Lo que NO se resuelve así es la foto grande de arriba: ésa entra al repo con
 * `scripts/traer_medios.py` y se sirve estática, porque es el LCP de la página y
 * cargarla por JavaScript la volvería lo último en aparecer.
 *
 * Si el endpoint no responde, el bloque simplemente no aparece. Una receta sin
 * video sigue siendo una receta completa.
 */
interface Props {
  slug: string;
  nombre: string;
}
const { slug, nombre } = Astro.props;

const URL_MEDIOS =
  import.meta.env.PUBLIC_MEDIOS_URL ??
  "https://www.baudry.com.ar/keto-panel/medios.php";
---

<section id="medios-propios" class="mt-10 hidden" aria-labelledby="medios-titulo">
  <h2 id="medios-titulo" class="text-xl font-bold text-hoja-700 mb-1">De la cocina</h2>
  <p class="text-sm text-hoja-900/50 mb-4">
    Fotos y videos del plato de verdad, hecho en casa.
  </p>
  <div id="medios-grilla" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
</section>

<script define:vars={{ slug, nombre, URL_MEDIOS }}>
  const seccion = document.getElementById("medios-propios");
  const grilla = document.getElementById("medios-grilla");

  const esc = (s) =>
    String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

  // Se pide sólo esta receta: el manifiesto completo son las 49 y acá interesa una.
  fetch(`${URL_MEDIOS}?slug=${encodeURIComponent(slug)}`, { mode: "cors" })
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      const reg = d?.recetas?.[slug];
      if (!reg) return;

      // ── La foto grande, si Ariel subió una del plato hecho ────────────────
      // El build estático la reemplaza de verdad (`scripts/traer_medios.py`),
      // pero eso pide un push y un deploy. Sin este cambio en el navegador, la
      // foto que se acaba de sacar en la cocina no se ve hasta entonces, y lo
      // primero que uno hace después de subirla es justamente ir a mirarla.
      let yaPuesta = null;
      if (reg.portada?.origen === "propia") {
        const foto = (reg.medios ?? []).find(
          (m) => m.id === reg.portada.ref && m.tipo === "imagen",
        );
        const img = document.getElementById("foto-receta");
        if (foto && img) {
          // `vista` y no `url`: la miniatura de 800 px alcanza para el ancho al
          // que se muestra, y el original puede ser una foto de iPhone de 4 MB.
          img.src = foto.vista;
          img.alt = `${nombre}, hecho en casa`;
          yaPuesta = foto.id;

          // El pie tiene que dejar de decir "el ingrediente principal, no el
          // plato terminado": sobre la foto del plato ya cocinado es falso.
          const pie = document.getElementById("pie-foto");
          if (pie) pie.textContent = "Foto propia, del plato hecho en casa.";
        }
      }

      const partes = [];

      for (const m of reg.medios ?? []) {
        // La que quedó de portada no se repite abajo.
        if (m.id === yaPuesta) continue;
        if (m.tipo === "video") {
          partes.push(
            `<video controls preload="metadata" playsinline
                    class="w-full rounded-xl bg-black aspect-square object-cover"
                    src="${esc(m.url)}"></video>`,
          );
        } else {
          // `vista` es la miniatura de 800 px; el original va en el enlace, para
          // quien quiera verla grande. Sin esto, una foto de iPhone son 4 MB.
          partes.push(
            `<a href="${esc(m.url)}" target="_blank" rel="noopener">
               <img src="${esc(m.vista)}" alt="${esc(nombre)}, hecho en casa"
                    loading="lazy" decoding="async"
                    class="w-full rounded-xl aspect-square object-cover bg-crema-200">
             </a>`,
          );
        }
      }

      for (const v of reg.youtube ?? []) {
        // Ni iframe ni miniatura. El iframe trae las cookies y el rastreo de
        // YouTube, pero `i.ytimg.com/vi/…` es igual de tercero: cargarla le
        // cuenta a Google que alguien abrió esta receta, sin que nadie haya
        // apretado nada. El sitio declara no tener terceros fuera de la
        // publicidad, así que la tarjeta se dibuja acá y sólo el clic sale.
        partes.push(
          `<a href="https://youtu.be/${esc(v)}" target="_blank" rel="noopener"
              class="grid place-items-center gap-2 aspect-square rounded-xl
                     bg-hoja-700 text-crema-50 hover:bg-hoja-600 transition p-4 text-center">
             <span class="w-14 h-14 rounded-full bg-crema-50/15 grid place-items-center text-2xl"
                   aria-hidden="true">▶</span>
             <span class="text-sm leading-snug">Ver el video en YouTube</span>
           </a>`,
        );
      }

      if (!partes.length) return;
      grilla.innerHTML = partes.join("");
      seccion.classList.remove("hidden");
    })
    .catch(() => {
      /* Sin conexión con el panel no hay bloque, y la receta se lee igual. */
    });
</script>
