---
import "../styles/global.css";
import Buscador from "../components/Buscador.astro";
import Contador from "../components/Contador.astro";
import { LEGALES } from "../data/legales.js";

const {
  titulo,
  descripcion,
  imagen = "/og-default.png",
  jsonld = null,
} = Astro.props;

const SITIO = "Keto Argentina";
const url = new URL(Astro.url.pathname, Astro.site ?? "https://ketofacil.vercel.app");

// Once ítems no entran en la barra de un notebook sin apretujarse. Se parte en
// dos: los cinco que resuelven el recorrido principal van arriba, el resto vive
// en el pie. **El menú del celular muestra los dos grupos**, porque ahí el
// espacio es vertical y no hay razón para esconder nada.
const GRUPOS = [
  {
    texto: "Comer",
    items: [
      { href: "/recetas", texto: "Recetas", pista: "49 con sus macros" },
      { href: "/plan-semanal", texto: "Plan semanal", pista: "7 días armados" },
      { href: "/lista-compras", texto: "Lista del súper", pista: "calculada para los que sean" },
      { href: "/productos", texto: "Qué comprar", pista: "góndola por góndola" },
    ],
  },
  {
    texto: "Cocinar",
    items: [
      { href: "/trucos", texto: "Trucos de cocina", pista: "por qué la carne queda gris" },
      { href: "/congelar", texto: "Congelar", pista: "qué se congela y qué no" },
    ],
  },
  {
    texto: "Entender",
    items: [
      { href: "/como-empezar", texto: "Cómo empezar", pista: "los 7 primeros días" },
      { href: "/controles-medicos", texto: "Controles médicos", pista: "qué estudios y cada cuánto" },
      { href: "/evidencia", texto: "Evidencia", pista: "con las fuentes citadas" },
      { href: "/negociemos", texto: "Negociemos", pista: "el alcohol, la fruta, la Coca Zero" },
      { href: "/ayuno-intermitente", texto: "Ayuno intermitente", pista: "16:8 y 20:4" },
    ],
  },
  {
    texto: "Hacer",
    items: [
      { href: "/ejercicios", texto: "Ejercicios", pista: "con audio guía" },
      { href: "/calculadora", texto: "Calculadora", pista: "tus macros y tu peso" },
      { href: "/calendario", texto: "Calendario", pista: "todo agendado" },
    ],
  },
];

// El pie va **plano**, con todo a la vista y sin submenús. Un pie de página es
// donde se busca lo que no se encontró arriba: esconder ahí las cosas detrás de
// un despliegue es esconderlas dos veces. Se deriva de los grupos para que no
// puedan quedar desincronizados.
const NAV_PIE = [
  ...GRUPOS.flatMap((g) => g.items),
  { href: "/quienes-somos", texto: "Quiénes somos" },
];
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={url.href} />

    {/* Verificación de Google Search Console.

        Va en el Layout y no sólo en la home: Google verifica contra la raíz,
        pero puesta acá queda en las 122 páginas y no se pierde el día que la
        portada cambie de forma. No es un secreto —viaja en el HTML de un sitio
        público— así que va al repo como cualquier otra etiqueta.

        **No se borra nunca**, ni después de que la verificación salga bien: si
        la etiqueta desaparece, Google desverifica la propiedad y con ella se van
        los informes de cobertura y el envío del sitemap. Es el reemplazo del
        registro DNS, que con un dominio `vercel.app` no se puede usar porque la
        zona no es nuestra. Ver SEO.md. */}
    <meta name="google-site-verification" content="oY0iAP-IvpOXfXBB36EyUGGjAAWBoFKMc_bBBQJ_aDA" />

    <title>{titulo} · {SITIO}</title>
    <meta name="description" content={descripcion} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={new URL(imagen, url).href} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Los datos estructurados son lo que hace que Google muestre la receta con
        foto y tiempo, y que los modelos de IA puedan citar el contenido. Cada
        página pasa el suyo. */}
    {jsonld && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    )}

    {/* AdSense: el script va acá, comentado hasta tener el ID aprobado. Los
        huecos (<AdSlot />) ya están reservados en el maquetado para que activarlo
        no mueva nada de lugar — que es lo que arruina los Core Web Vitals. */}
    {/*
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXX"
            crossorigin="anonymous"></script>
    */}
  </head>

  <body class="min-h-screen flex flex-col">
    <header class="bg-hoja-700 text-crema-50 sticky top-0 z-50 shadow-md">
      <div class="mx-auto max-w-5xl px-4">
        <div class="flex items-center justify-between h-14">
          <a href="/" class="font-bold text-lg tracking-tight flex items-center gap-2">
            <span aria-hidden="true">🥑</span> Keto Argentina
          </a>

          <nav class="hidden md:flex gap-1 items-center" aria-label="Principal">
            {GRUPOS.map((g) => (
              /* `h-14` y no sólo `relative`: el contenedor tiene que medir toda
                 la altura de la barra para que el panel cuelgue del borde de
                 abajo y no de la mitad del botón. Ver el comentario del script. */
              <div class="relative h-14 flex items-center" data-menu>
                <button
                  type="button"
                  class="px-2.5 py-2 rounded-md text-sm hover:bg-hoja-600 transition-colors whitespace-nowrap flex items-center gap-1"
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {g.texto}
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor"
                       stroke-width="2" class="opacity-60 transition-transform" data-flecha aria-hidden="true">
                    <path d="M2 4l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div
                  data-panel
                  class="hidden absolute left-0 top-full min-w-[15rem] rounded-b-xl bg-crema-50 text-hoja-900 shadow-xl ring-1 ring-hoja-900/10 py-1.5 z-50"
                >
                  {g.items.map((i) => (
                    <a href={i.href} class="block px-4 py-2 hover:bg-hoja-100 transition-colors">
                      <span class="block text-sm font-medium text-hoja-800">{i.texto}</span>
                      {i.pista && <span class="block text-xs text-hoja-900/50">{i.pista}</span>}
                    </a>
                  ))}
                </div>
              </div>
            ))}
            {/* El buscador aparece recién en `lg`. Entre 768 y 1023 px —un iPad
                vertical— el logo, los cinco enlaces del nav y una caja de 224 px
                no entran en los 1024 px del contenedor, y la barra se salía del
                ancho de la página: el sitio entero scrolleaba de costado. En esa
                franja se llega a la búsqueda desde el menú, como en el teléfono. */}
            <div class="ml-2 hidden lg:block"><Buscador /></div>
          </nav>

          <button
            id="btn-menu"
            class="md:hidden p-2 rounded-md hover:bg-hoja-600"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="menu-movil"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
            </svg>
          </button>
        </div>

        <nav id="menu-movil" class="md:hidden hidden pb-3" aria-label="Principal móvil">
          <div class="px-1 pb-2"><Buscador /></div>
          {/* En el celular no hay desplegables: el espacio es vertical y no hay
              ninguna razón para hacer tocar dos veces. Los grupos son títulos. */}
          {GRUPOS.map((g) => (
            <>
              <p class="px-3 pt-3 pb-1 text-[11px] uppercase tracking-wide text-crema-100/50">
                {g.texto}
              </p>
              {g.items.map((i) => (
                <a href={i.href} class="block px-3 py-2 rounded-md text-sm hover:bg-hoja-600">
                  {i.texto}
                </a>
              ))}
            </>
          ))}
          <a href="/quienes-somos" class="block px-3 py-2 rounded-md text-sm hover:bg-hoja-600">
            Quiénes somos
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1 mx-auto max-w-5xl w-full px-4 py-8">
      <slot />
    </main>

    <footer class="bg-hoja-900 text-crema-100 mt-12">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm space-y-4">
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {NAV_PIE.map((i) => (
            <a href={i.href} class="hover:text-naranja-400 transition-colors">{i.texto}</a>
          ))}
        </div>
        <p class="text-crema-200/70 leading-relaxed max-w-3xl">
          Este sitio es material informativo, no consejo médico. La dieta cetogénica
          cambia cómo el cuerpo maneja el azúcar y los líquidos: si tomás medicación,
          estás embarazada o tenés una condición renal, hepática o diabetes,
          consultá con un profesional antes de empezar.
        </p>

        {/* Los legales van en su propia línea y separados del resto de la
            navegación: mezclados entre las secciones de contenido no se
            encuentran, y son las páginas que se buscan cuando se buscan. */}
        <div class="pt-4 border-t border-crema-100/10 flex flex-wrap gap-x-5 gap-y-2 text-crema-200/70">
          {LEGALES.map((l) => (
            <a href={`/${l.slug}`} class="hover:text-naranja-400 transition-colors">{l.titulo}</a>
          ))}
        </div>

        <div class="pt-2 flex flex-wrap items-center justify-between gap-4">
          <p class="text-crema-200/50">
            © {new Date().getFullYear()} Keto Argentina ·{" "}
            <a href="/quienes-somos" class="hover:text-naranja-400 underline underline-offset-2">Quiénes somos</a>
          </p>
          <Contador />
        </div>
      </div>
    </footer>

    <script>
      // Menú móvil. Diez líneas de JS y nada más: el resto del sitio es HTML
      // estático, que es lo que mantiene los Core Web Vitals en verde.
      const btn = document.getElementById("btn-menu");
      const menu = document.getElementById("menu-movil");
      btn?.addEventListener("click", () => {
        const abierto = menu.classList.toggle("hidden") === false;
        btn.setAttribute("aria-expanded", String(abierto));
      });

      // Desplegables del menú de escritorio.
      //
      // Se abren con clic y no sólo con `:hover`: con hover puro no hay forma de
      // llegar con el teclado ni de usarlos en una pantalla táctil, que es
      // exactamente la mitad de las visitas. El hover se suma encima para el que
      // usa mouse.
      // Y el hover cierra **con un respiro de 150 ms**. Sin eso, cualquier
      // milímetro que el puntero pise fuera del contenedor —el borde entre dos
      // menús, el pixel entre el botón y el panel— dispara `mouseleave` y el
      // submenú desaparece antes de que el mouse llegue. Con el respiro, volver
      // a entrar cancela el cierre y el recorrido lento funciona igual que el
      // rápido, que era exactamente el bug.
      const GRACIA = 150;

      const desplegables = [...document.querySelectorAll("[data-menu]")];

      function cerrarTodos(salvo) {
        for (const d of desplegables) {
          if (d === salvo) continue;
          d.querySelector("[data-panel]").classList.add("hidden");
          d.querySelector("button").setAttribute("aria-expanded", "false");
          d.querySelector("[data-flecha]").classList.remove("rotate-180");
        }
      }

      for (const d of desplegables) {
        const boton = d.querySelector("button");
        const panel = d.querySelector("[data-panel]");
        const flecha = d.querySelector("[data-flecha]");

        const mostrar = (v) => {
          panel.classList.toggle("hidden", !v);
          boton.setAttribute("aria-expanded", String(v));
          flecha.classList.toggle("rotate-180", v);
          if (v) cerrarTodos(d);
        };

        let cierre = null;
        const cancelar = () => {
          if (cierre) clearTimeout(cierre);
          cierre = null;
        };

        boton.addEventListener("click", (e) => {
          e.stopPropagation();
          cancelar();
          mostrar(panel.classList.contains("hidden"));
        });
        d.addEventListener("mouseenter", () => {
          cancelar();
          mostrar(true);
        });
        d.addEventListener("mouseleave", () => {
          cancelar();
          cierre = setTimeout(() => mostrar(false), GRACIA);
        });
        // Al salir del último enlace con Tab, el panel se cierra solo.
        d.addEventListener("focusout", (e) => {
          if (!d.contains(e.relatedTarget)) mostrar(false);
        });
      }

      document.addEventListener("click", () => cerrarTodos(null));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") cerrarTodos(null);
      });
    </script>
  </body>
</html>
