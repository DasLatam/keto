---
// Layout de las tres páginas legales. Existe para que Condiciones, Privacidad y
// Cookies compartan exactamente el mismo maquetado: si cada una trae su propio
// ancho de columna y su propia jerarquía de títulos, se nota que fueron pegadas
// de distintos lados y le baja la credibilidad al sitio entero.
//
// Los textos son los mismos que usa DAS LATAM (daslatam.org), adaptados a este
// sitio: cambia el responsable, el correo de contacto, la finalidad del sitio y
// lo que este sitio sí hace y aquel no (publicidad, almacenamiento local de las
// listas, contenido sobre salud).
import Layout from "./Layout.astro";
import { LEGALES } from "../data/legales.js";

const { titulo, descripcion, actualizado, slug } = Astro.props;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: titulo,
  description: descripcion,
  inLanguage: "es-AR",
  dateModified: actualizado,
  publisher: { "@type": "Organization", name: "Keto Argentina" },
};
---

<Layout titulo={titulo} descripcion={descripcion} jsonld={jsonld}>
  <nav class="text-sm text-hoja-900/50 mb-4" aria-label="Miga de pan">
    <a href="/" class="hover:underline">Inicio</a> · <span>{titulo}</span>
  </nav>

  <article class="prosa max-w-3xl legal">
    <h1 class="text-3xl md:text-4xl font-bold text-hoja-700 leading-tight">{titulo}</h1>
    <p class="mt-2 text-sm text-hoja-900/50">
      Última actualización: <time datetime={actualizado}>{
        new Date(`${actualizado}T12:00:00`).toLocaleDateString("es-AR", {
          day: "numeric", month: "long", year: "numeric",
        })
      }</time>
    </p>

    <slot />

    <nav class="mt-12 pt-6 border-t border-hoja-100" aria-label="Otras páginas legales">
      <p class="text-sm font-medium text-hoja-700">Las otras dos</p>
      <ul class="mt-2 space-y-1">
        {LEGALES.filter((l) => l.slug !== slug).map((l) => (
          <li>
            <a href={`/${l.slug}`} class="text-naranja-600 hover:underline text-sm">{l.titulo}</a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</Layout>

<style>
  /* Los títulos y párrafos de los textos legales se escriben como HTML plano en
     cada página, sin clases de Tailwind por elemento: son documentos largos y
     llenarlos de `class` los volvería imposibles de actualizar. Se estilan acá,
     una vez, por selector de descendencia. */
  .legal :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-hoja-700);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .legal :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-hoja-700);
    margin-top: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .legal :global(p) {
    margin-top: 0.75rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-hoja-900) 80%, transparent);
  }

  .legal :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal :global(li) {
    margin-top: 0.375rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-hoja-900) 80%, transparent);
  }

  .legal :global(a) {
    color: var(--color-naranja-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal :global(strong) {
    color: var(--color-hoja-700);
  }

  /* Los recuadros de aviso: se usan para lo que no puede pasar desapercibido
     (que el sitio no es consejo médico, cómo se ejercen los derechos). */
  .legal :global(.aviso) {
    margin-top: 1.5rem;
    border-radius: 0.75rem;
    background: var(--color-crema-100);
    border: 1px solid var(--color-hoja-100);
    padding: 1rem 1.25rem;
  }

  .legal :global(.aviso p:first-child) {
    margin-top: 0;
  }

  /* Las tablas de las cookies necesitan scroll propio en el celular: el ancho
     mínimo de tres columnas de texto no entra en 360px. */
  .legal :global(.tabla) {
    margin-top: 1rem;
    overflow-x: auto;
  }

  .legal :global(table) {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .legal :global(th),
  .legal :global(td) {
    text-align: left;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-hoja-100);
    vertical-align: top;
    line-height: 1.6;
  }

  .legal :global(th) {
    background: var(--color-crema-100);
    color: var(--color-hoja-700);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
